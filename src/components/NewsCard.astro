---
export interface Props {
  id: string;
  title: string;
  slug?: string;
  excerpt: string;
  category: string;
  source: string;
  sourceUrl?: string;
  imageUrl?: string;
  publishedAt: string;
  readTime?: string;
  isFeatured?: boolean;
}

const {
  id,
  title,
  slug,
  excerpt,
  category,
  source,
  sourceUrl,
  imageUrl = "https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=800&q=80",
  publishedAt,
  readTime = "3 min read",
  isFeatured = false
} = Astro.props;

function formatPublishedDate(dateStr: string) {
  try {
    const date = new Date(dateStr);
    const now = new Date();
    const diffHours = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60));
    
    if (diffHours < 1) return 'Just now';
    if (diffHours < 24) return `${diffHours}h ago`;
    if (diffHours < 48) return 'Yesterday';
    return date.toLocaleDateString('en-IN', { month: 'short', day: 'numeric' });
  } catch (e) {
    return dateStr;
  }
}

const formattedDate = formatPublishedDate(publishedAt);

const categoryBadgeConfig: Record<string, { bg: string; text: string; border: string; icon: string }> = {
  'Local News': { bg: 'bg-blue-600/90 text-white', text: 'text-blue-400', border: 'border-blue-500/30', icon: '📍' },
  'Smart City & Infra': { bg: 'bg-emerald-600/90 text-white', text: 'text-emerald-400', border: 'border-emerald-500/30', icon: '🏗️' },
  'Culture & Tourism': { bg: 'bg-amber-600/90 text-white', text: 'text-amber-400', border: 'border-amber-500/30', icon: '🏛️' },
  'Education & Tech': { bg: 'bg-purple-600/90 text-white', text: 'text-purple-400', border: 'border-purple-500/30', icon: '🎓' },
  'Business & Jobs': { bg: 'bg-orange-600/90 text-white', text: 'text-orange-400', border: 'border-orange-500/30', icon: '💼' },
  'Environment & City': { bg: 'bg-teal-600/90 text-white', text: 'text-teal-400', border: 'border-teal-500/30', icon: '🌿' },
};

const badge = categoryBadgeConfig[category] || { bg: 'bg-slate-700 text-white', text: 'text-slate-300', border: 'border-slate-600', icon: '📰' };

const articleHref = slug ? `/news/${slug}` : (sourceUrl || `#${id}`);

const whatsappShareText = encodeURIComponent(`⚡ जबलपुर समाचार: ${title}\n\nविस्तार से पढ़िए जबलपुरिया पर:\nhttps://jabalpuriya.com/news/${slug || id}`);
const whatsappUrl = `https://api.whatsapp.com/send?text=${whatsappShareText}`;
---

<article 
  class={`news-article-card group relative flex flex-col bg-white dark:bg-[#0c1c33] rounded-3xl overflow-hidden border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 ${isFeatured ? 'md:col-span-2 md:flex-row' : ''}`}
  data-category={category}
  id={id}
>
  <!-- Card Thumbnail with Aspect Ratio Box (Zero CLS) -->
  <a href={articleHref} class={`relative overflow-hidden bg-slate-900 block ${isFeatured ? 'md:w-1/2 aspect-video md:aspect-auto' : 'aspect-[16/10] w-full'}`}>
    <img
      src={imageUrl}
      alt={title}
      loading="lazy"
      decoding="async"
      width="800"
      height="500"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=800&q=80';"
    />
    
    <!-- Vivid Image Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
    
    <!-- Floating Category Pill -->
    <div class="absolute top-3.5 left-3.5 z-10">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold backdrop-blur-md shadow-lg border ${badge.bg} ${badge.border}`}>
        <span>{badge.icon}</span>
        <span>{category}</span>
      </span>
    </div>

    {isFeatured && (
      <div class="absolute top-3.5 right-3.5 z-10">
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-red-600 text-white shadow-xl animate-pulse">
          <span>⚡</span> Top Headline
        </span>
      </div>
    )}
  </a>

  <!-- Content Section -->
  <div class={`flex flex-col justify-between p-5 sm:p-6 ${isFeatured ? 'md:w-1/2' : 'flex-1'} bg-gradient-to-b from-white to-slate-50/50 dark:from-[#0c1c33] dark:to-[#081527]`}>
    <div class="space-y-3">
      
      <!-- Meta Details: Source & Relative Time -->
      <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-2 flex-wrap">
        <div class="flex items-center space-x-2">
          <!-- Verified Source Pill -->
          <span class="inline-flex items-center font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800/90 px-2.5 py-1 rounded-lg border border-slate-200/60 dark:border-slate-700/60">
            <svg class="w-3 h-3 text-emerald-500 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            {source}
          </span>
          <span class="text-slate-400">•</span>
          <time datetime={publishedAt} class="font-semibold text-slate-600 dark:text-slate-300">{formattedDate}</time>
        </div>
        <span class="text-amber-600 dark:text-amber-400 text-[11px] font-bold bg-amber-50 dark:bg-amber-950/40 px-2 py-0.5 rounded-md">{readTime}</span>
      </div>

      <!-- Article Title -->
      <h3 class={`font-black tracking-tight text-slate-900 dark:text-white group-hover:text-jabalpur-secondary transition-colors leading-snug ${isFeatured ? 'text-xl sm:text-2xl lg:text-3xl' : 'text-lg sm:text-xl line-clamp-2'}`}>
        <a href={articleHref} class="focus:outline-none hover:underline">
          {title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class={`text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed ${isFeatured ? 'line-clamp-3 sm:line-clamp-4' : 'line-clamp-2'}`}>
        {excerpt}
      </p>
    </div>

    <!-- Read Story & WhatsApp CTA -->
    <div class="pt-3.5 mt-3.5 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between gap-2">
      <a 
        href={articleHref}
        class="inline-flex items-center text-xs sm:text-sm font-black text-jabalpur-secondary hover:text-[#e04a10] transition-colors gap-1.5"
        aria-label={`Read coverage: ${title}`}
      >
        <span>पूरी खबर पढ़ें</span>
        <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- WhatsApp Share Button -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-600 text-emerald-700 dark:text-emerald-400 hover:text-white transition-all text-xs font-bold border border-emerald-500/20 shadow-sm hover:scale-105"
        title="Share on WhatsApp"
        aria-label="Share story on WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</article>
