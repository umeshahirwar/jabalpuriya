---
const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Latest News', href: '/#news-grid' },
  { name: '✨ Rashifal (राशिफल)', href: '/#rashifal' },
  { name: 'Culture & Tourism', href: '/#culture' },
  { name: 'City Services', href: '/#directory' },
  { name: 'About Jabalpur', href: '/#about' },
];

const currentPath = Astro.url.pathname;
---

<header class="w-full bg-white/95 dark:bg-[#07162c]/95 backdrop-blur-md border-b border-slate-200/90 dark:border-slate-800 shadow-md sticky top-0 z-50">
  
  <!-- Top Auxiliary Ribbon with Live Ticker -->
  <div class="bg-gradient-to-r from-jabalpur-950 via-[#072445] to-jabalpur-950 text-slate-200 text-xs py-2 px-4 sm:px-6 lg:px-8 border-b border-jabalpur-800/60 overflow-hidden">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Live Indicator Tag -->
      <div class="flex items-center space-x-2 flex-shrink-0">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
        </span>
        <span class="font-extrabold uppercase tracking-widest text-red-400 text-[10px] bg-red-950/80 px-2 py-0.5 rounded border border-red-800/60">
          BREAKING WIRE
        </span>
      </div>

      <!-- Ticker Marquee -->
      <div class="flex-1 overflow-hidden relative max-w-2xl hidden md:block">
        <div class="animate-ticker-infinite text-xs text-slate-300 font-medium">
          <span class="mx-4 font-bold text-amber-400">⚡ Sanskaardhani 24x7:</span>
          <span>Bhedaghat & Dhuandhar record autumn tourism surge •</span>
          <span class="mx-2 text-emerald-400">JMC Zero Waste Ward Drive Launches •</span>
          <span class="mx-2 text-sky-400">IIITDM Jabalpur AI Prototyping Center operational •</span>
          <span class="mx-2 text-orange-400">Gwarighat Maha Aarti ghat promenade expansion complete •</span>
        </div>
      </div>

      <!-- Location & Live IST Clock -->
      <div class="flex items-center space-x-3 flex-shrink-0 text-[11px] text-slate-300">
        <span class="font-bold text-jabalpur-300 flex items-center gap-1">
          📍 Jabalpur, MP
        </span>
        <span class="text-slate-500">•</span>
        <span class="font-semibold text-emerald-400" id="live-ist-date">
          Sanskaardhani Time
        </span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo with Saffron & Navy Gradients -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center space-x-3.5 group">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-tr from-jabalpur-950 via-jabalpur-700 to-jabalpur-secondary flex items-center justify-center shadow-lg group-hover:scale-105 group-hover:rotate-1 transition-all duration-300 ring-2 ring-jabalpur-secondary/30">
            <span class="text-white font-black text-2xl font-serif">J</span>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white group-hover:text-jabalpur-secondary transition-colors">
                Jabalpuriya
              </span>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-gradient-to-r from-jabalpur-secondary to-amber-500 text-white font-black tracking-wider uppercase shadow-sm">
                .com
              </span>
            </div>
            <span class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 font-bold tracking-wide font-hindi">
              संस्कारधानी जबलपुर का डिजिटल मंच
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-1.5" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-xl text-sm font-bold transition-all duration-200 ${
              item.name.includes('Rashifal')
                ? 'text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 hover:bg-amber-100 dark:hover:bg-amber-900/60 border border-amber-200 dark:border-amber-800/60 shadow-sm'
                : currentPath === item.href
                  ? 'text-white bg-jabalpur-primary shadow-md'
                  : 'text-slate-700 hover:text-jabalpur-secondary hover:bg-slate-100 dark:text-slate-200 dark:hover:text-white dark:hover:bg-slate-800/80'
            }`}
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden p-2.5 rounded-xl text-slate-700 dark:text-slate-300 hover:text-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-jabalpur-secondary"
        >
          <svg id="menu-open-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#07162c]/95 backdrop-blur-lg px-4 pt-3 pb-6 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 dark:text-slate-200 hover:text-jabalpur-secondary hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        {item.name}
      </a>
    ))}
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (menuBtn && mobileMenu && openIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  const dateEl = document.getElementById('live-ist-date');
  if (dateEl) {
    const options: Intl.DateTimeFormatOptions = { 
      weekday: 'short', 
      year: 'numeric', 
      month: 'short', 
      day: 'numeric',
      timeZone: 'Asia/Kolkata'
    };
    dateEl.textContent = new Intl.DateTimeFormat('en-IN', options).format(new Date());
  }
</script>
