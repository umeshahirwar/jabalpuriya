---
export interface Props {
  slotType: 'masthead' | 'sidebar' | 'bottom' | 'in-feed';
  adSlot?: string;
  className?: string;
}

const {
  slotType = 'masthead',
  adSlot,
  className = ''
} = Astro.props;

const adClient = "ca-pub-4149190564501770";

let containerClasses = "";
let minHeightStyle = "";

if (slotType === 'masthead') {
  containerClasses = "w-full max-w-5xl mx-auto my-3 text-center";
  minHeightStyle = "min-height: 90px;";
} else if (slotType === 'sidebar') {
  containerClasses = "w-full max-w-[320px] mx-auto my-4 text-center";
  minHeightStyle = "min-height: 250px;";
} else if (slotType === 'bottom' || slotType === 'in-feed') {
  containerClasses = "w-full max-w-5xl mx-auto my-6 text-center";
  minHeightStyle = "min-height: 90px;";
}
---

<div
  class={`adsense-wrapper relative overflow-hidden rounded-2xl bg-slate-100/40 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 p-2 transition-all ${containerClasses} ${className}`}
  style={minHeightStyle}
>
  <!-- Subtle Ad Disclosure -->
  <div class="ad-label flex items-center justify-between px-2 pb-1 text-[10px] uppercase font-bold tracking-wider text-slate-400 dark:text-slate-500 select-none">
    <span class="flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500/60 inline-block"></span>
      Advertisement • विज्ञापन
    </span>
    <span class="text-[9px] text-slate-400/70">Jabalpuriya</span>
  </div>

  <!-- Google AdSense Unit Container -->
  <div class="flex items-center justify-center w-full overflow-hidden">
    <ins
      class="adsbygoogle w-full block"
      style="display:block"
      data-ad-client={adClient}
      {...(adSlot ? { 'data-ad-slot': adSlot } : {})}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
</div>

<style>
  /* Collapse empty ad slots automatically if Google AdSense marks them unfilled */
  .adsense-wrapper:has(ins[data-ad-status="unfilled"]) {
    display: none !important;
  }
</style>

<script is:inline>
  try {
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  } catch (e) {
    // Gracefully handle ad-blocker or script block
  }

  // Fallback observer: if AdSense sets unfilled status, hide the wrapper container
  if (typeof window !== 'undefined' && 'MutationObserver' in window) {
    document.querySelectorAll('.adsense-wrapper').forEach((wrapper) => {
      const ins = wrapper.querySelector('ins.adsbygoogle');
      if (ins) {
        const observer = new MutationObserver(() => {
          if (ins.getAttribute('data-ad-status') === 'unfilled') {
            wrapper.style.display = 'none';
          }
        });
        observer.observe(ins, { attributes: true, attributeFilter: ['data-ad-status'] });
      }
    });
  }
</script>
