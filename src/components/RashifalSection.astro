---
import rashifalData from '../data/rashifal.json';
---

<section id="rashifal" class="my-16 py-12 px-6 sm:px-10 bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-slate-900/10 dark:from-[#0f1f38] dark:via-[#09172a] dark:to-[#050f1d] rounded-3xl border border-amber-300/80 dark:border-amber-900/50 shadow-xl">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-amber-300/60 dark:border-slate-800 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-md">
          ✨ दैनिक एवं वार्षिक राशिफल • Rashifal {rashifalData.year}
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          {rashifalData.title}
        </h2>
        <p class="text-slate-700 dark:text-slate-300 text-sm max-w-2xl font-medium">
          {rashifalData.subtitle}
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-white dark:bg-slate-800 border border-amber-200 dark:border-slate-700 text-xs font-bold text-amber-800 dark:text-amber-300 shadow-sm">
          <span>🪐</span> ग्रह गोचर: बृहस्पति & शनि संचरण
        </span>
      </div>
    </div>

    <!-- 12 Rashis Selector Grid -->
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-12 gap-2.5" id="rashi-selector-bar">
      {rashifalData.rashis.map((rashi, idx) => (
        <button
          type="button"
          data-rashi-id={rashi.id}
          class={`rashi-tab-btn flex flex-col items-center justify-center p-3 rounded-2xl border transition-all duration-300 cursor-pointer text-center ${
            idx === 0
              ? 'bg-gradient-to-b from-amber-500 to-orange-600 text-white border-amber-600 shadow-lg scale-105 ring-2 ring-amber-400/50'
              : 'bg-white/90 dark:bg-[#0c1c33] text-slate-800 dark:text-slate-200 border-slate-200 dark:border-slate-800 hover:border-amber-400 hover:bg-amber-50/80 dark:hover:bg-slate-800 hover:scale-105'
          }`}
        >
          <span class="text-2xl drop-shadow">{rashi.symbol}</span>
          <span class="text-xs font-black font-hindi mt-1">{rashi.nameHindi}</span>
          <span class="text-[10px] font-bold opacity-80">{rashi.nameEnglish}</span>
        </button>
      ))}
    </div>

    <!-- Active Rashi Detailed Card Showcase -->
    <div id="rashi-details-container" class="mt-6">
      {rashifalData.rashis.map((rashi, idx) => (
        <div
          id={`rashi-card-${rashi.id}`}
          class={`rashi-card bg-white dark:bg-[#0c1c33] rounded-3xl p-6 sm:p-10 border border-amber-200/80 dark:border-slate-800 shadow-xl ${idx === 0 ? 'block' : 'hidden'}`}
        >
          <!-- Top Rashi Identity Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-500 via-orange-500 to-amber-400 text-white flex items-center justify-center text-3xl shadow-lg ring-4 ring-amber-200/50 dark:ring-amber-900/30">
                {rashi.symbol}
              </div>
              <div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-hindi">
                    {rashi.nameHindi} राशिफल
                  </h3>
                  <span class="text-sm font-bold text-amber-600 dark:text-amber-400">
                    ({rashi.nameEnglish} Horoscope)
                  </span>
                </div>
                <p class="text-xs sm:text-sm font-bold text-orange-600 dark:text-orange-400 mt-1 font-hindi">
                  ✨ {rashi.summary}
                </p>
              </div>
            </div>

            <!-- Quick Vedic Indicators -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
                <span class="block text-[10px] text-slate-400 font-bold">स्वामी ग्रह (Lord)</span>
                <span class="font-black text-slate-900 dark:text-slate-100 font-hindi">{rashi.lord}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
                <span class="block text-[10px] text-slate-400 font-bold">तत्व (Element)</span>
                <span class="font-black text-slate-900 dark:text-slate-100 font-hindi">{rashi.element}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
                <span class="block text-[10px] text-slate-400 font-bold">शुभ अंक (Lucky No)</span>
                <span class="font-black text-emerald-600 dark:text-emerald-400 text-sm">{rashi.luckyNumber}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-center">
                <span class="block text-[10px] text-slate-400 font-bold">शुभ रंग (Lucky Color)</span>
                <span class="font-black text-amber-600 dark:text-amber-400 font-hindi text-[11px]">{rashi.luckyColor}</span>
              </div>
            </div>
          </div>

          <!-- Predictions Detailed Content Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8">
            
            <!-- Career & Business -->
            <div class="bg-gradient-to-br from-blue-50/80 to-indigo-50/40 dark:from-slate-900/80 dark:to-slate-900/40 p-6 rounded-2xl border border-blue-200/70 dark:border-slate-800 space-y-2">
              <div class="flex items-center space-x-2 text-jabalpur-primary dark:text-jabalpur-300 font-black text-sm">
                <span>💼</span>
                <h4>करियर एवं व्यवसाय (Career & Finance)</h4>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-hindi">
                {rashi.career}
              </p>
              <p class="text-xs text-slate-600 dark:text-slate-400 pt-1 font-hindi">
                {rashi.finance}
              </p>
            </div>

            <!-- Health & Family -->
            <div class="bg-gradient-to-br from-emerald-50/80 to-teal-50/40 dark:from-slate-900/80 dark:to-slate-900/40 p-6 rounded-2xl border border-emerald-200/70 dark:border-slate-800 space-y-2">
              <div class="flex items-center space-x-2 text-emerald-800 dark:text-emerald-400 font-black text-sm">
                <span>🧘</span>
                <h4>स्वास्थ्य एवं परिवार (Health & Harmony)</h4>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-hindi">
                {rashi.health}
              </p>
            </div>

            <!-- Astrological Remedy / Upay -->
            <div class="bg-gradient-to-br from-amber-50 to-orange-50/60 dark:from-amber-950/40 dark:to-slate-900/60 p-6 rounded-2xl border border-amber-300 dark:border-amber-900/50 space-y-2">
              <div class="flex items-center space-x-2 text-amber-900 dark:text-amber-300 font-black text-sm">
                <span>🪔</span>
                <h4>ज्योतिषीय सरल उपाय (Remedy)</h4>
              </div>
              <p class="text-xs sm:text-sm text-amber-950 dark:text-amber-200 leading-relaxed font-hindi">
                {rashi.remedy}
              </p>
              <div class="pt-2">
                <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black bg-amber-200 text-amber-950 dark:bg-amber-900/80 dark:text-amber-200 shadow-sm">
                  संस्कारधानी पंचांग सम्मत
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.rashi-tab-btn');
  const cards = document.querySelectorAll('.rashi-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const rashiId = btn.getAttribute('data-rashi-id');

      tabBtns.forEach(b => {
        b.classList.remove('bg-gradient-to-b', 'from-amber-500', 'to-orange-600', 'text-white', 'border-amber-600', 'shadow-lg', 'scale-105', 'ring-2', 'ring-amber-400/50');
        b.classList.add('bg-white/90', 'dark:bg-[#0c1c33]', 'text-slate-800', 'dark:text-slate-200', 'border-slate-200', 'dark:border-slate-800');
      });

      btn.classList.add('bg-gradient-to-b', 'from-amber-500', 'to-orange-600', 'text-white', 'border-amber-600', 'shadow-lg', 'scale-105', 'ring-2', 'ring-amber-400/50');
      btn.classList.remove('bg-white/90', 'dark:bg-[#0c1c33]', 'text-slate-800', 'dark:text-slate-200');

      cards.forEach(card => {
        if (card.id === `rashi-card-${rashiId}`) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.add('hidden');
          card.classList.remove('block');
        }
      });
    });
  });
</script>
