---
import rashifalData from '../data/rashifal.json';
---

<section id="rashifal" class="my-16 py-12 px-6 sm:px-8 bg-gradient-to-br from-amber-50/70 via-orange-50/40 to-slate-100 dark:from-[#0d1e33] dark:via-[#091524] dark:to-[#07111e] rounded-3xl border border-amber-200/70 dark:border-amber-900/40 shadow-sm">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-amber-200/60 dark:border-slate-800 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60">
          ✨ दैनिक एवं वार्षिक राशिफल • Rashifal {rashifalData.year}
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          {rashifalData.title}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
          {rashifalData.subtitle}
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 shadow-sm">
          🪐 ग्रह गोचर: बृहस्पति & शनि संचरण
        </span>
      </div>
    </div>

    <!-- 12 Rashis Selector Grid -->
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-12 gap-2" id="rashi-selector-bar">
      {rashifalData.rashis.map((rashi, idx) => (
        <button
          type="button"
          data-rashi-id={rashi.id}
          class={`rashi-tab-btn flex flex-col items-center justify-center p-3 rounded-2xl border transition-all duration-200 cursor-pointer text-center ${
            idx === 0
              ? 'bg-amber-500 text-white border-amber-600 shadow-md scale-105'
              : 'bg-white/80 dark:bg-[#10223a] text-slate-700 dark:text-slate-300 border-slate-200/80 dark:border-slate-800 hover:border-amber-300 dark:hover:border-amber-700 hover:bg-amber-50 dark:hover:bg-slate-800'
          }`}
        >
          <span class="text-2xl">{rashi.symbol}</span>
          <span class="text-xs font-bold font-hindi mt-1">{rashi.nameHindi}</span>
          <span class="text-[10px] opacity-75">{rashi.nameEnglish}</span>
        </button>
      ))}
    </div>

    <!-- Active Rashi Detailed Card Showcase -->
    <div id="rashi-details-container" class="mt-6">
      {rashifalData.rashis.map((rashi, idx) => (
        <div
          id={`rashi-card-${rashi.id}`}
          class={`rashi-card bg-white dark:bg-[#0c1a2e] rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-lg ${idx === 0 ? 'block' : 'hidden'}`}
        >
          <!-- Top Rashi Identity Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white flex items-center justify-center text-3xl shadow-md">
                {rashi.symbol}
              </div>
              <div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-hindi">
                    {rashi.nameHindi} राशिफल
                  </h3>
                  <span class="text-sm font-semibold text-slate-500 dark:text-slate-400">
                    ({rashi.nameEnglish} Horoscope)
                  </span>
                </div>
                <p class="text-xs sm:text-sm font-medium text-amber-700 dark:text-amber-400 mt-1">
                  ✨ {rashi.summary}
                </p>
              </div>
            </div>

            <!-- Quick Vedic Indicators -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700">
                <span class="block text-[10px] text-slate-400 font-medium">स्वामी ग्रह (Lord)</span>
                <span class="font-bold text-slate-800 dark:text-slate-200 font-hindi">{rashi.lord}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700">
                <span class="block text-[10px] text-slate-400 font-medium">तत्व (Element)</span>
                <span class="font-bold text-slate-800 dark:text-slate-200 font-hindi">{rashi.element}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700">
                <span class="block text-[10px] text-slate-400 font-medium">शुभ अंक (Lucky No)</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400">{rashi.luckyNumber}</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700">
                <span class="block text-[10px] text-slate-400 font-medium">शुभ रंग (Lucky Color)</span>
                <span class="font-bold text-amber-600 dark:text-amber-400 font-hindi text-[11px]">{rashi.luckyColor}</span>
              </div>
            </div>
          </div>

          <!-- Predictions Detailed Content Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8">
            
            <!-- Career & Business -->
            <div class="bg-slate-50/80 dark:bg-slate-900/60 p-5 sm:p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/80 space-y-2">
              <div class="flex items-center space-x-2 text-jabalpur-primary dark:text-jabalpur-300 font-bold text-sm">
                <span>💼</span>
                <h4>करियर एवं व्यवसाय (Career & Finance)</h4>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-hindi">
                {rashi.career}
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400 pt-1 font-hindi">
                {rashi.finance}
              </p>
            </div>

            <!-- Health & Family -->
            <div class="bg-slate-50/80 dark:bg-slate-900/60 p-5 sm:p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/80 space-y-2">
              <div class="flex items-center space-x-2 text-emerald-700 dark:text-emerald-400 font-bold text-sm">
                <span>🧘</span>
                <h4>स्वास्थ्य एवं परिवार (Health & Harmony)</h4>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-hindi">
                {rashi.health}
              </p>
            </div>

            <!-- Astrological Remedy / Upay -->
            <div class="bg-amber-50/80 dark:bg-amber-950/40 p-5 sm:p-6 rounded-2xl border border-amber-200/80 dark:border-amber-900/50 space-y-2">
              <div class="flex items-center space-x-2 text-amber-800 dark:text-amber-300 font-bold text-sm">
                <span>🪔</span>
                <h4>ज्योतिषीय सरल उपाय (Remedy)</h4>
              </div>
              <p class="text-xs sm:text-sm text-amber-900 dark:text-amber-200/90 leading-relaxed font-hindi">
                {rashi.remedy}
              </p>
              <div class="pt-2">
                <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-200/60 dark:bg-amber-900/60 text-amber-900 dark:text-amber-300">
                  संस्कारधानी जबलपुर पंचांग सम्मत
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Rashi Tab Switching Logic
  const tabBtns = document.querySelectorAll('.rashi-tab-btn');
  const cards = document.querySelectorAll('.rashi-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const rashiId = btn.getAttribute('data-rashi-id');

      // Update button active state
      tabBtns.forEach(b => {
        b.classList.remove('bg-amber-500', 'text-white', 'border-amber-600', 'shadow-md', 'scale-105');
        b.classList.add('bg-white/80', 'dark:bg-[#10223a]', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/80', 'dark:border-slate-800');
      });

      btn.classList.add('bg-amber-500', 'text-white', 'border-amber-600', 'shadow-md', 'scale-105');
      btn.classList.remove('bg-white/80', 'dark:bg-[#10223a]', 'text-slate-700', 'dark:text-slate-300');

      // Show selected card
      cards.forEach(card => {
        if (card.id === `rashi-card-${rashiId}`) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.add('hidden');
          card.classList.remove('block');
        }
      });
    });
  });
</script>
