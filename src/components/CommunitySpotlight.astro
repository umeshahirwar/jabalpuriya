---
const attractions = [
  {
    title: "Bhedaghat & Marble Rocks",
    hindi: "भेड़ाघाट और संगमरमर की चट्टानें",
    category: "UNESCO Tentative Heritage",
    description: "Towering 100-foot white marble canyon carved by the holy Narmada river, world-renowned for moonlight boating and pristine river serenity.",
    image: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80",
    badge: "Must Experience",
    badgeColor: "bg-emerald-600 text-white"
  },
  {
    title: "Dhuandhar Waterfalls",
    hindi: "धुआंधार जलप्रपात",
    category: "Natural Wonder",
    description: "The magnificent cascade where the Narmada plunges over a sheer rocky drop, throwing up a misty cloud that resembles smoke (dhuan).",
    image: "https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=800&q=80",
    badge: "Iconic Landmark",
    badgeColor: "bg-sky-600 text-white"
  },
  {
    title: "Madan Mahal & Balancing Rock",
    hindi: "मदन महल और बैलेंसिंग रॉक",
    category: "Gondwana Heritage",
    description: "11th-century royal watchtower castle built by Gond ruler Raja Madan Singh, perched on an astonishing natural balancing rock formation.",
    image: "https://images.unsplash.com/photo-1590050752117-238cb0fb12b1?auto=format&fit=crop&w=800&q=80",
    badge: "Historic Fort",
    badgeColor: "bg-amber-600 text-white"
  },
  {
    title: "Gwarighat Maha Aarti",
    hindi: "ग्वारीघाट माँ नर्मदा महाआरती",
    category: "Spiritual Culture",
    description: "Daily sacred evening prayer on the riverfront ghats with synchronized brass lamps and devotional hymns echoing across the Narmada.",
    image: "https://images.unsplash.com/photo-1561361513-2d000a50f0dc?auto=format&fit=crop&w=800&q=80",
    badge: "Daily Devotion",
    badgeColor: "bg-orange-600 text-white"
  }
];
---

<section id="culture" class="my-16 py-12 px-6 sm:px-10 bg-gradient-to-b from-white via-slate-50 to-amber-50/30 dark:from-[#091a30] dark:via-[#061426] dark:to-[#040e1c] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xl">
  <div class="max-w-7xl mx-auto space-y-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-amber-500/20 to-orange-500/20 text-orange-700 dark:text-amber-300 border border-amber-300 dark:border-amber-700/60 shadow-sm">
          🏛️ Heritage & Tourism
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          Pride of Jabalpur <span class="text-jabalpur-secondary font-hindi font-normal">(संस्कारधानी की धरोहर)</span>
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl font-medium">
          Discover the world-famous geological wonders, ancient forts, and sacred traditions that make Jabalpur the cultural capital of Central India.
        </p>
      </div>

      <div class="flex-shrink-0">
        <a href="#news-grid" class="inline-flex items-center px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-jabalpur-primary hover:bg-jabalpur-secondary transition-all shadow">
          <span>Explore All City Stories</span>
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Spotlight Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {attractions.map((item) => (
        <div class="group bg-white dark:bg-[#0c1c33] rounded-3xl overflow-hidden border border-slate-200/90 dark:border-slate-800 shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 flex flex-col">
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-900">
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3">
              <span class={`px-3 py-1 rounded-full text-[11px] font-black shadow-lg ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>
          </div>
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <span class="text-[11px] font-extrabold text-jabalpur-secondary uppercase tracking-wider block">
                {item.category}
              </span>
              <h3 class="text-base font-black text-slate-900 dark:text-white mt-1">
                {item.title}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-hindi font-semibold">
                {item.hindi}
              </p>
              <p class="text-xs text-slate-600 dark:text-slate-300 mt-2.5 leading-relaxed line-clamp-3">
                {item.description}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold text-jabalpur-primary dark:text-jabalpur-300 group-hover:text-jabalpur-secondary flex items-center gap-1 transition-colors">
                Read Tourism Guide
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
