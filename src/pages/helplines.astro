---
import Layout from '../layouts/Layout.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';

const helplineCategories = [
  {
    title: "आपातकालीन सेवाएं (Emergency 24x7)",
    icon: "🚨",
    items: [
      { name: "अखिल भारतीय आपातकालीन नंबर", number: "112", desc: "पुलिस, एम्बुलेंस और फायर सर्विस हेतु एकल आपातकालीन नंबर" },
      { name: "पुलिस कंट्रोल रूम जबलपुर", number: "100 / 0761-2676100", desc: "जबलपुर पुलिस नियंत्रण कक्ष व त्वरित प्रतिक्रिया दल" },
      { name: "एम्बुलेंस सेवा (Ambulance)", number: "108", desc: "निःशुल्क सरकारी आपातकालीन चिकित्सा परिवहन सेवा" },
      { name: "अग्निशमन सेवा (Fire Brigade)", number: "101 / 0761-2611111", desc: "जबलपुर नगर निगम दमकल सेवा" },
      { name: "साइबर क्राइम हेल्पलाइन", number: "1930", desc: "ऑनलाइन वित्तीय धोखाधड़ी या डिजिटल अपराध की तत्काल रिपोर्टिंग" }
    ]
  },
  {
    title: "नगर निगम व नागरिक सेवाएं (JMC & Civic)",
    icon: "🏛️",
    items: [
      { name: "नगर निगम जबलपुर (JMC) कॉल सेंटर", number: "0761-2611111", desc: "सफाई, जलप्रदाय, सीवर और कचरा गाड़ी संबंधित शिकायत" },
      { name: "स्मार्ट सिटी जबलपुर कंट्रोल सेंटर", number: "1800-233-0104", desc: "स्मार्ट सिटी नागरिक सेवाएं व आईसीसीसी सहायता" },
      { name: "बिजली शिकायत (MPEB / MPPKVVCL)", number: "1912", desc: "पावर कट, ट्रांसफॉर्मर खराबी व बिजली बिल शिकायत (24 घंटे)" },
      { name: "सीएम हेल्पलाइन मध्य प्रदेश", number: "181", desc: "शासकीय योजनाओं व प्रशासनिक समस्याओं का समाधान" }
    ]
  },
  {
    title: "प्रमुख अस्पताल व ब्लड बैंक (Hospitals & Blood Banks)",
    icon: "🏥",
    items: [
      { name: "नेताजी सुभाष चंद्र बोस मेडिकल कॉलेज", number: "0761-2370951", desc: "संभागीय शासकीय सुपर स्पेशियलिटी शिक्षण चिकित्सालय" },
      { name: "विक्टोरिया जिला चिकित्सालय", number: "0761-2620134", desc: "जिला अस्पताल जबलपुर (ओपीडी व आपातकालीन वार्ड)" },
      { name: "एल्गिन महिला अस्पताल (Lady Elgin)", number: "0761-2620352", desc: "मातृत्व व शिशु स्वास्थ्य केंद्र जबलपुर" },
      { name: "रेड क्रॉस ब्लड बैंक जबलपुर", number: "0761-2621020", desc: "आपातकालीन रक्त व प्लेटलेट्स उपलब्धता" }
    ]
  },
  {
    title: "महिला, बाल व वरिष्ठ नागरिक सुरक्षा",
    icon: "🛡️",
    items: [
      { name: "महिला हेल्पलाइन (Women Helpline)", number: "1090 / 181", desc: "घरेलू हिंसा, उत्पीड़न व आपातकालीन महिला सहायता" },
      { name: "चाइल्डलाइन (Childline)", number: "1098", desc: "बच्चों की सुरक्षा, सहायता व पुनर्वास" },
      { name: "वरिष्ठ नागरिक हेल्पलाइन (Elderline)", number: "14567", desc: "बुजुर्गों के लिए निःशुल्क सहायता व मार्गदर्शन" }
    ]
  }
];
---

<Layout
  title="Jabalpur Helplines & Emergency Directory 2026 | जबलपुर आवश्यक हेल्पलाइन नंबर"
  description="जबलपुर शहर के सभी आपातकालीन नंबर, नगर निगम (JMC) शिकायत, बिजली (MPEB), विक्टोरिया व मेडिकल अस्पताल, पुलिस कंट्रोल रूम और नागरिक सहायता डायरेक्टरी।"
  keywords={["Jabalpur Helplines", "JMC Jabalpur Complaint Number", "MPEB Jabalpur Electricity", "Victoria Hospital Jabalpur", "जबलपुर हेल्पलाइन", "Jabalpur Police Contact"]}
>
  <div class="max-w-4xl mx-auto py-6 sm:py-10 space-y-10">
    
    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
        📞 नागरिक सेवा डायरेक्टरी (24x7 Verified)
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        जबलपुर आवश्यक सेवा व हेल्पलाइन डायरेक्टरी
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        आपातकाल, पुलिस, चिकित्सा, विद्युत, नगर निगम और नागरिक सुविधाओं के लिए संस्कारधानी जबलपुर के सभी अधिकृत संपर्क नंबर।
      </p>

      <div class="pt-2 flex justify-center">
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent('📞 जबलपुर शहर की आवश्यक हेल्पलाइन व इमरजेंसी डायरेक्टरी 2026 - पुलिस, अस्पताल, बिजली और नगर निगम नंबर:\nhttps://jabalpuriya.com/helplines')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-lg hover:scale-105 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          <span>यह डायरेक्टरी WhatsApp पर शेयर करें</span>
        </a>
      </div>
    </header>

    <!-- Top Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Categories List -->
    <div class="space-y-8">
      {helplineCategories.map((cat) => (
        <section class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
            <span>{cat.icon}</span>
            <span>{cat.title}</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {cat.items.map((item) => (
              <div class="p-5 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200/90 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-3 hover:border-jabalpur-secondary transition-colors">
                <div>
                  <h3 class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white">
                    {item.name}
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {item.desc}
                  </p>
                </div>
                
                <div class="pt-2 flex items-center justify-between border-t border-slate-100 dark:border-slate-800/80">
                  <span class="font-black text-base sm:text-lg text-emerald-600 dark:text-emerald-400 tracking-wide">
                    {item.number}
                  </span>
                  <a
                    href={`tel:${item.number.split('/')[0].trim()}`}
                    class="px-3.5 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-600 text-emerald-700 dark:text-emerald-300 hover:text-white font-bold text-xs transition-all flex items-center gap-1 shadow-sm"
                  >
                    <span>कॉल करें</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- In-Feed AdSense -->
    <AdSenseBanner slotType="in-feed" />

    <div class="text-center pt-4">
      <a href="/" class="inline-flex items-center px-6 py-3 rounded-xl font-bold text-sm bg-jabalpur-primary text-white hover:bg-jabalpur-secondary transition-all shadow-md">
        ← मुख्य पृष्ठ (Home) पर लौटें
      </a>
    </div>

  </div>
</Layout>
