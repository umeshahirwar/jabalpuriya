                  </a>
                  <a
                    href={articleUrl}
                    target={isInternal ? undefined : "_blank"}
                    rel={isInternal ? undefined : "noopener noreferrer"}
                    class="text-xs font-extrabold text-jabalpur-primary dark:text-jabalpur-300 hover:text-jabalpur-secondary transition-colors"
                  >
                    पूरी खबर पढ़ें →
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Authentic Official Market Resources & Regulatory Links -->
