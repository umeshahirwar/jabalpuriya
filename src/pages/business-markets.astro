<script>
  // 1. Live IST Market Session Status Indicator (Mon–Fri, 9:15 AM – 3:30 PM IST)
  const statusEl = document.getElementById('ist-market-status');
  if (statusEl) {
    const now = new Date();
    const istParts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).formatToParts(now);

    const weekday = istParts.find((p) => p.type === 'weekday')?.value || '';
    const hour = parseInt(istParts.find((p) => p.type === 'hour')?.value || '0', 10);
    const minute = parseInt(istParts.find((p) => p.type === 'minute')?.value || '0', 10);
    const mins = hour * 60 + minute;
    const isWeekday = !['Sat', 'Sun'].includes(weekday);

    if (isWeekday && mins >= 555 && mins <= 930) {
      statusEl.textContent = '🟢 NSE/BSE Market Open (Live Session)';
      statusEl.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30';
    } else if (isWeekday && mins >= 540 && mins < 555) {
      statusEl.textContent = '🟡 NSE/BSE Pre-Open Session (9:00–9:15 IST)';
      statusEl.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black bg-amber-500/15 text-amber-700 dark:text-amber-400 border border-amber-500/30';
    } else {
      statusEl.textContent = '🔴 Market Closed (Latest Exchange Close)';
      statusEl.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700';
    }
  }

  // 2. Interactive Business News Category Filter
  const filterBtns = document.querySelectorAll('.biz-filter-btn');
  const newsCards = document.querySelectorAll('.biz-news-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-biz-filter') || 'All';

      filterBtns.forEach((b) => {
        b.className = 'biz-filter-btn px-4 py-2 rounded-2xl text-xs font-black whitespace-nowrap transition-all cursor-pointer bg-white dark:bg-[#0c1c33] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-jabalpur-secondary';
      });
      btn.className = 'biz-filter-btn px-4 py-2 rounded-2xl text-xs font-black whitespace-nowrap transition-all cursor-pointer bg-gradient-to-r from-jabalpur-primary to-jabalpur-700 text-white shadow-md';

      newsCards.forEach((card) => {
        const cat = card.getAttribute('data-biz-category');
        if (selected === 'All' || cat === selected) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
