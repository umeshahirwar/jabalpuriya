---
import Layout from '../../layouts/Layout.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import newsData from '../../data/news.json';

export async function getStaticPaths() {
  return newsData.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

// Format dates
const pubDate = new Date(article.publishedAt);
const formattedDate = pubDate.toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Kolkata'
});

const formattedTime = pubDate.toLocaleTimeString('en-IN', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Kolkata'
});

// Related stories: prioritize same category first for stronger topical clustering, then fill to 4
const sameCategory = newsData.articles.filter((a) => a.id !== article.id && a.category === article.category);
const otherCategory = newsData.articles.filter((a) => a.id !== article.id && a.category !== article.category);
const relatedArticles = [...sameCategory, ...otherCategory].slice(0, 4);

// Canonical & Share URLs (always trailing slash to match GitHub Pages & prevent 301 redirects)
const articleUrl = `https://jabalpuriya.com/news/${article.slug}/`;
const isBusinessCategory = ['Stock Market', 'India Business', 'हिंदी बिजनेस', 'Business & Jobs'].includes(article.category);

const whatsappShareText = encodeURIComponent(
  isBusinessCategory
    ? `📈 शेयर बाजार व बिजनेस समाचार: ${article.title}\n\nविस्तार से पढ़िए जबलपुरिया पर:\n${articleUrl}`
    : `⚡ जबलपुर समाचार: ${article.title}\n\nविस्तार से पढ़िए जबलपुरिया पर:\n${articleUrl}`
);
const whatsappShareUrl = `https://api.whatsapp.com/send?text=${whatsappShareText}`;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(articleUrl)}&via=jabalpuriya`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`;

const isHindi = /[\u0900-\u097F]/.test(article.title);

// Category-specific local Jabalpur context to add genuine editorial depth
const categoryContextMap: Record<string, { heading: string; text: string; tipLabel: string; tipHref: string }> = {
  'Stock Market': {
    heading: 'भारतीय शेयर बाजार व स्टॉक एक्सचेंज संदर्भ (Stock Market & NSE/BSE Context)',
    text: 'भारतीय शेयर बाजार (NSE NIFTY 50, BSE SENSEX, BANK NIFTY) देश की आर्थिक विकास यात्रा और शीर्ष कंपनियों का आईना है। जबलपुर व मध्य प्रदेश के निवेशकों, कारोबारियों और ट्रेडर्स के लिए बाज़ार के ताज़ा रुझान, सेबी (SEBI) नियम और वित्तीय अपडेट्स यहाँ विश्लेषित किए जाते हैं।',
    tipLabel: '📈 आज का लाइव निफ्टी 50, सेंसेक्स चार्ट व ब्लू-चिप स्टॉक्स देखें',
    tipHref: '/business-markets/'
  },
  'India Business': {
    heading: 'भारतीय अर्थव्यवस्था, कॉर्पोरेट व व्यापार परिदृश्य (India Economy & Business Context)',
    text: 'भारत की जीडीपी ग्रोथ, रिज़र्व बैंक (RBI) मौद्रिक नीति, कॉर्पोरेट परिणाम और राष्ट्रीय वाणिज्यिक नीतियों का असर पूरे देश के व्यापारिक केंद्रों पर होता है। जबलपुरिया बिजनेस डेस्क स्थानीय व राष्ट्रीय स्तर पर वित्तीय अवसरों का विश्वसनीय विश्लेषण प्रस्तुत करता है।',
    tipLabel: '📈 भारत के शीर्ष ब्लू-चिप स्टॉक्स व बिजनेस डेस्क देखें',
    tipHref: '/business-markets/'
  },
  'हिंदी बिजनेस': {
    heading: 'ताज़ा हिंदी व्यापार व वित्तीय समाचार (Hindi Business Desk)',
    text: 'भारतीय शेयर बाजार, कमोडिटी, सराफा (सोना-चांदी) और व्यापार जगत की महत्वपूर्ण खबरें हिंदी में। जबलपुर और महाकौशल संभाग के व्यापारियों और नागरिकों के लिए उपयोगी वित्तीय जानकारी।',
    tipLabel: '🌾 जबलपुर कृषि उपज मंडी व सराफा के दैनिक भाव देखें',
    tipHref: '/mandi-bhav/'
  },
  'Smart City & Infra': {
    heading: 'जबलपुर स्मार्ट सिटी व अधोसंरचना संदर्भ (Civic & Infra Context)',
    text: 'जबलपुर मध्य प्रदेश का एक प्रमुख स्मार्ट सिटी और महाकौशल अंचल का सबसे बड़ा परिवहन व शहरी केंद्र है। रिंग रोड, मदन महल फ्लाईओवर, डुमना एयरपोर्ट विस्तार और पश्चिम मध्य रेलवे (WCR) की परियोजनाएं शहर की कनेक्टिविटी को निरंतर सशक्त बना रही हैं।',
    tipLabel: '📞 जबलपुर नगर निगम व आपातकालीन हेल्पलाइन देखें',
    tipHref: '/helplines/'
  },
  'Culture & Tourism': {
    heading: 'संस्कारधानी पर्यटन व सांस्कृतिक विरासत (Heritage Context)',
    text: 'मां नर्मदा के पावन तट पर बसा जबलपुर अपनी संगमरमर की चट्टानों (भेड़ाघाट), धुआंधार जलप्रपात, ग्वारीघाट महाआरती और गोंडवाना कालीन ऐतिहासिक धरोहरों के लिए देशभर में प्रसिद्ध है। पर्यटन और लोक संस्कृति से जुड़े हर बड़े आयोजन की जानकारी जबलपुरिया पर उपलब्ध है।',
    tipLabel: '🌊 भेड़ाघाट व धुआंधार संपूर्ण पर्यटन गाइड पढ़ें',
    tipHref: '/bhedaghat-guide/'
  },
  'Education & Tech': {
    heading: 'शिक्षा व तकनीकी हब जबलपुर (Education & Tech Context)',
    text: 'जबलपुर में रानी दुर्गावती विश्वविद्यालय (RDVV), IIITDM जबलपुर, नेताजी सुभाष चंद्र बोस मेडिकल कॉलेज, जबलपुर इंजीनियरिंग कॉलेज (JEC) और नानाजी देशमुख पशु चिकित्सा विश्वविद्यालय जैसे प्रतिष्ठित संस्थान स्थित हैं, जो महाकौशल के छात्रों को उच्च शिक्षा व तकनीक के नए अवसर दे रहे हैं।',
    tipLabel: '✨ छात्रों व नागरिकों के लिए आज का दैनिक राशिफल देखें',
    tipHref: '/rashifal/'
  },
  'Business & Jobs': {
    heading: 'जबलपुर व्यापार, मंडी व रोजगार परिदृश्य (Economy Context)',
    text: 'जबलपुर रक्षा कारखानों (OFK, VFJ, GCF), गारमेंट क्लस्टर, रिछाई औद्योगिक क्षेत्र और प्रसिद्ध जबलपुरी हरा मटर (ODOP) कृषि उपज मंडी के कारण मध्य भारत का महत्वपूर्ण व्यापारिक केंद्र है। दैनिक फसल व सराफा बाजार भाव से व्यापारियों और किसानों को सीधा लाभ मिलता है।',
    tipLabel: '🌾 आज का जबलपुर कृषि उपज मंडी व सराफा भाव देखें',
    tipHref: '/mandi-bhav/'
  },
  'Environment & City': {
    heading: 'नर्मदा संरक्षण व शहर पर्यावरण (Environment Context)',
    text: 'डुमना नेचर रिजर्व, बरगी बांध और मां नर्मदा का कछार जबलपुर को प्राकृतिक रूप से समृद्ध बनाते हैं। स्वच्छ सर्वेक्षण में राष्ट्रीय स्तर पर अग्रणी प्रदर्शन के साथ शहर के मौसम, जल संरक्षण और हरित पहल पर नियमित अपडेट यहाँ संकलित किए जाते हैं।',
    tipLabel: '🪔 ग्वारीघाट नर्मदा महाआरती समय व घाट गाइड देखें',
    tipHref: '/gwarighat-aarti/'
  },
  'Local News': {
    heading: 'जबलपुरिया कम्युनिटी विज़न (Our Mission & Community Vision)',
    text: 'Jabalpuriya.com is a dedicated digital news portal and community platform headquartered in Jabalpur, Madhya Pradesh. Founded with the mission to connect the residents and global diaspora of Sanskaardhani, we are building this platform from the ground up with the vision to connect people and make this your home away from home.',
    tipLabel: '🏡 जबलपुरिया मुख्य पृष्ठ पर सभी सेवाएं देखें',
    tipHref: '/'
  }
};

const localContext = categoryContextMap[article.category] || categoryContextMap['Local News'];

// Build comprehensive structured story narrative and summary
function buildStoryNarrative(art: typeof article) {
  const isHindiText = /[\u0900-\u097F]/.test(art.title);
  const cleanTitle = art.title.replace(/\s*-\s*[^-]+$/, '').trim();
  const sourceName = art.source || 'Jabalpur Wire';

  if (isHindiText) {
    return {
      overview: art.excerpt && art.excerpt.length > 50 && !art.excerpt.includes(cleanTitle)
        ? art.excerpt
        : `${cleanTitle} - संस्कारधानी जबलपुर और मध्य प्रदेश से जुड़ी इस महत्वपूर्ण गतिविधि पर मुख्य विवरण सामने आया है।`,
      sections: [
        {
          title: 'मुख्य घटनाक्रम व समाचार विवरण (Story Overview)',
          content: `${sourceName} की रिपोर्ट के अनुसार, "${cleanTitle}" को लेकर ताज़ा अपडेट सामने आया है। इस विषय पर क्षेत्र के नागरिकों, संबंधित विभागों और स्थानीय समुदाय में चर्चा बनी हुई है। मामले से जुड़े सभी पहलुओं पर नजर रखी जा रही है ताकि जनसामान्य को स्पष्ट जानकारी मिल सके।`
        },
        {
          title: 'पृष्ठभूमि व स्थानीय प्रभाव (Context & Significance)',
          content: art.category === 'Smart City & Infra'
            ? `जबलपुर शहर में अधोसंरचना, रेलवे, सड़क और स्मार्ट सिटी परियोजनाओं का सीधा असर आम नागरिकों के दैनिक जीवन पर पड़ता है। इस कार्य से महाकौशल क्षेत्र में सुगम आवागमन, समय की बचत और नागरिक सुविधाओं में सुधार की उम्मीद है।`
            : art.category === 'Culture & Tourism'
            ? `संस्कारधानी जबलपुर अपनी समृद्ध सांस्कृतिक विरासत, मां नर्मदा के पावन तटों और ऐतिहासिक धरोहरों के लिए विख्यात है। इस प्रकार के सामाजिक व सांस्कृतिक आयोजन शहर की सामूहिक पहचान को सशक्त बनाते हैं।`
            : art.category === 'Stock Market' || art.category === 'हिंदी बिजनेस' || art.category === 'India Business'
            ? `भारतीय वित्तीय बाजारों और व्यापारिक गतिविधियों में होने वाले उतार-चढ़ाव का सीधा संबंध निवेशकों की धारणा और आर्थिक संकेतकों से होता है। विश्लेषक बाज़ार के रुझानों और कॉरपोरेट घोषणाओं पर नजर बनाए हुए हैं।`
            : `जबलपुर और आसपास के अंचल में हो रहे इन सामाजिक व सामुदायिक घटनाक्रमों का सीधा संबंध नागरिकों के दैनिक जनजीवन से है। क्षेत्र में व्यवस्था को सुचारू बनाए रखने और विकास को गति देने के प्रयास निरंतर जारी हैं।`
        },
        {
          title: 'नागरिकों व पाठकों के लिए उपयोगी जानकारी (What You Need to Know)',
          content: `इस समाचार से जुड़ी विस्तृत रिपोर्टिंग और आगे के घटनाक्रम के लिए मूल प्रकाशक (${sourceName}) की कवरेज का संदर्भ लें। जबलपुरिया कम्युनिटी इस विषय पर स्थानीय नागरिकों और देश-विदेश में बसे जबलपुरी साथियों के विचारों का स्वागत करती है।`
        }
      ],
      bullets: [
        `मुख्य विषय: ${cleanTitle}`,
        `संबंधित क्षेत्र: ${['Stock Market', 'India Business', 'हिंदी बिजनेस'].includes(art.category) ? 'भारतीय वित्तीय बाजार' : 'जबलपुर (संस्कारधानी), मध्य प्रदेश'}`,
        `रिपोर्टिंग वायर: ${sourceName}`,
        `श्रेणी: ${art.category}`
      ]
    };
  } else {
    return {
      overview: art.excerpt && art.excerpt.length > 50 && !art.excerpt.includes(cleanTitle)
        ? art.excerpt
        : `${cleanTitle} - Here is a comprehensive overview and key takeaways from the latest reporting.`,
      sections: [
        {
          title: 'Development Overview & Core Details',
          content: `According to reporting by ${sourceName}, "${cleanTitle}" represents a notable recent update. The development has drawn attention from local residents, industry observers, and civic stakeholders across the region.`
        },
        {
          title: 'Context, Regional Impact & Key Drivers',
          content: art.category === 'Smart City & Infra'
            ? `Infrastructure, railway modernizations, and civic expansion projects across Jabalpur play a pivotal role in strengthening regional mobility and economic convenience for the Mahakoshal division.`
            : art.category === 'Culture & Tourism'
            ? `Cultural festivals, heritage conservation, and tourism along the sacred Narmada riverbanks continue to define the vibrant spirit and community bond of Sanskaardhani Jabalpur.`
            : art.category === 'Stock Market' || art.category === 'India Business'
            ? `In the broader Indian financial ecosystem, corporate performance, capital inflows, and regulatory frameworks drive investor sentiment and market liquidity across key benchmark indices.`
            : `Civic, educational, and community developments in Jabalpur contribute directly to local growth, public awareness, and civic participation across the district.`
        },
        {
          title: 'Citizen & Community Takeaway',
          content: `Readers and community members are encouraged to review the official wire report on ${sourceName} for further granular data, official communiqués, and ongoing developments.`
        }
      ],
      bullets: [
        `Core Focus: ${cleanTitle}`,
        `Location: ${['Stock Market', 'India Business', 'हिंदी बिजनेस'].includes(art.category) ? 'Indian Financial Markets' : 'Jabalpur, Madhya Pradesh'}`,
        `Reporting Wire: ${sourceName}`,
        `Topic Category: ${art.category}`
      ]
    };
  }
}

const narrative = buildStoryNarrative(article);

// BreadcrumbList Schema for Google Search Rich Hierarchy
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://jabalpuriya.com/" },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isBusinessCategory ? "Business & Stock Market" : article.category,
      "item": isBusinessCategory ? "https://jabalpuriya.com/business-markets/" : "https://jabalpuriya.com/#news-grid"
    },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": articleUrl }
  ]
};
---

<Layout
  title={`${article.title} | Jabalpuriya News`}
  description={article.excerpt}
  image={article.imageUrl}
  canonicalUrl={articleUrl}
  type="article"
  publishedTime={article.publishedAt}
  category={article.category}
  keywords={isBusinessCategory
    ? [article.category, 'Indian Stock Market', 'Business News India', 'शेयर बाजार', 'Nifty 50', 'BSE Sensex', article.source, 'Jabalpur Business']
    : [article.category, 'Jabalpur News', 'जबलपुर समाचार', 'Sanskaardhani', article.source, 'MP News']}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="max-w-4xl mx-auto py-6 sm:py-10 space-y-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center space-x-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 overflow-x-auto pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-jabalpur-secondary transition-colors whitespace-nowrap">Home</a>
      <span>/</span>
      <a href={isBusinessCategory ? "/business-markets/" : "/#news-grid"} class="hover:text-jabalpur-secondary transition-colors whitespace-nowrap">
        {isBusinessCategory ? "Business & Markets" : "Jabalpur News"}
      </a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-bold whitespace-nowrap">{article.category}</span>
    </nav>

    <!-- Top Masthead Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Main Article Card -->
    <article class="bg-white dark:bg-[#0c1c33] rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-xl overflow-hidden p-6 sm:p-10 space-y-6">
      
      <!-- Meta & Category Pill Header -->
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3 flex-wrap text-xs">
          <div class="flex items-center gap-2">
            <span class="px-3.5 py-1.5 rounded-full font-black uppercase tracking-wider bg-gradient-to-r from-jabalpur-secondary to-orange-600 text-white shadow-sm">
              {article.category}
            </span>
            <span class="px-3 py-1 rounded-full font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
              ✓ {article.source}
            </span>
          </div>
          <span class="text-slate-500 dark:text-slate-400 font-semibold">
            {article.readTime}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white leading-tight tracking-tight">
          {article.title}
        </h1>

        <!-- Timestamp & Reporter Attribution -->
        <div class="flex items-center justify-between text-xs sm:text-sm text-slate-500 dark:text-slate-400 border-y border-slate-100 dark:border-slate-800/80 py-3 flex-wrap gap-2">
          <div class="flex items-center space-x-2">
            <span>{isBusinessCategory ? '📈 भारतीय वित्तीय बाजार / National Wire' : '📍 Jabalpur, MP'}</span>
            <span>•</span>
            <time datetime={article.publishedAt}>{formattedDate} at {formattedTime} IST</time>
          </div>
          <span class="text-jabalpur-secondary font-bold font-hindi">
            {isBusinessCategory ? 'जबलपुरिया बिजनेस डेस्क' : 'जबलपुरिया न्यूज़ डेस्क'}
          </span>
        </div>
      </div>

      <!-- Hero Article Image -->
      <div class="relative rounded-2xl overflow-hidden bg-slate-950 aspect-[16/9] shadow-md">
        <img
          src={article.imageUrl}
          alt={article.title}
          class="w-full h-full object-cover"
          loading="eager"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=1200&q=80';"
        />
        <div class="absolute bottom-2.5 right-2.5 bg-black/60 backdrop-blur-md px-3 py-1 rounded-lg text-[10px] text-white/90">
          Photo: Jabalpur Wire / {article.source}
        </div>
      </div>

      <!-- Viral Social Sharing Actions (WhatsApp Priority) -->
      <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 dark:from-emerald-950/30 dark:via-slate-900 dark:to-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <p class="text-sm font-black text-slate-900 dark:text-white flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-emerald-600">💬</span> यह खबर दोस्तों व परिजनों से साझा करें
          </p>
          <p class="text-xs text-slate-600 dark:text-slate-400">Share this update with fellow Jabalpurias & family groups</p>
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-center">
          <a
            href={whatsappShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm flex items-center gap-2 shadow-lg hover:shadow-xl hover:scale-105 transition-all"
            aria-label="Share on WhatsApp"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
            <span>WhatsApp पर शेयर करें</span>
          </a>

          <a
            href={twitterShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-sky-500 transition-colors"
            title="Share on X (Twitter)"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <a
            href={facebookShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-blue-600 transition-colors"
            title="Share on Facebook"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      <!-- Main Article Content & Structured Summary -->
      <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg space-y-6">
        
        <!-- Story Overview Lead Paragraph -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 space-y-3">
          <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-jabalpur-secondary">
            <span>⚡</span> त्वरित समाचार सारांश (Executive Summary)
          </div>
          <p class="font-medium text-slate-900 dark:text-white text-base sm:text-lg leading-relaxed">
            {narrative.overview}
          </p>
        </div>

        <!-- Key Takeaways Bullets -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#071324] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-jabalpur-secondary">📌</span> मुख्य बातें (Key Takeaways)
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300 list-none pl-0">
            {narrative.bullets.map((bullet) => (
              <li class="flex items-start gap-2 bg-slate-50 dark:bg-slate-900/50 p-2.5 rounded-xl border border-slate-200/60 dark:border-slate-800">
                <span class="text-jabalpur-secondary mt-0.5">•</span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Structured Narrative Sections -->
        <div class="space-y-5 pt-2">
          {narrative.sections.map((section, idx) => (
            <section class="space-y-2">
              <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-jabalpur-primary/10 dark:bg-jabalpur-primary/20 text-jabalpur-secondary text-xs flex items-center justify-center font-bold">
                  {idx + 1}
                </span>
                <span>{section.title}</span>
              </h3>
              <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
                {section.content}
              </p>
            </section>
          ))}
        </div>

        {isBusinessCategory && (
          <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-amber-900 dark:text-amber-200 space-y-1.5">
            <p class="font-bold flex items-center gap-1.5">
              <span>⚠️</span> वित्तीय व निवेश अस्वीकरण (Investor Notice):
            </p>
            <p class="leading-relaxed">
              शेयर बाजार, आईपीओ (IPO) और वित्तीय संपत्तियों में निवेश बाजार जोखिमों के अधीन है। यह रिपोर्ट केवल सामान्य सूचनात्मक उद्देश्य के लिए है। किसी भी वित्तीय निर्णय से पहले SEBI पंजीकृत वित्तीय सलाहकार से परामर्श अवश्य लें।
            </p>
          </div>
        )}

        <!-- Community Diaspora & Mission Box (Connecting People Globally) -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-orange-500/10 via-amber-500/5 to-transparent border border-orange-500/20 space-y-3">
          <div class="flex items-center gap-2 text-jabalpur-secondary font-black text-sm">
            <span>🏡</span> जबलपुरिया कम्युनिटी मिशन (Our Vision & Mission)
          </div>
          <p class="text-xs sm:text-sm text-slate-800 dark:text-slate-200 leading-relaxed font-medium">
            <strong>Jabalpuriya.com</strong> is a dedicated digital news portal and community platform headquartered in Jabalpur, Madhya Pradesh. Founded with the mission to connect the residents and global diaspora of <em>Sanskaardhani</em>. We are building this platform from the ground up with the vision to connect people and make this your home away from home.
          </p>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-hindi">
            संस्कारधानी जबलपुर और देश-विदेश में बसे हर जबलपुरी साथी को अपनी जड़ों से जोड़ना ही हमारा मुख्य संकल्प है।
          </p>
        </div>

        <!-- Contextual Local Jabalpur Insight -->
        <div class="p-5 rounded-2xl bg-sky-50/70 dark:bg-sky-950/20 border border-sky-200/70 dark:border-sky-800/40 space-y-2.5">
          <h3 class="text-sm font-black text-slate-900 dark:text-white">
            📍 {localContext.heading}
          </h3>
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            {localContext.text}
          </p>
          <a
            href={localContext.tipHref}
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-extrabold text-jabalpur-secondary hover:underline pt-1"
          >
            <span>{localContext.tipLabel}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Useful Jabalpur City Guides Strip -->
        <div class="pt-2">
          <p class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5">
            संस्कारधानी जबलपुर उपयोगी गाइड (City Essentials)
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-bold">
            <a href="/business-markets/" class="px-3 py-1.5 rounded-xl bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 hover:bg-indigo-500/20 transition-colors">📈 शेयर बाजार व बिजनेस</a>
            <a href="/mandi-bhav/" class="px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 hover:bg-emerald-500/20 transition-colors">🌾 मंडी व सराफा भाव</a>
            <a href="/rashifal/" class="px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 hover:bg-amber-500/20 transition-colors">✨ आज का राशिफल</a>
            <a href="/bhedaghat-guide/" class="px-3 py-1.5 rounded-xl bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20 hover:bg-sky-500/20 transition-colors">🌊 भेड़ाघाट गाइड</a>
            <a href="/gwarighat-aarti/" class="px-3 py-1.5 rounded-xl bg-teal-500/10 text-teal-700 dark:text-teal-300 border border-teal-500/20 hover:bg-teal-500/20 transition-colors">🪔 ग्वारीघाट आरती</a>
            <a href="/helplines/" class="px-3 py-1.5 rounded-xl bg-orange-500/10 text-orange-700 dark:text-orange-300 border border-orange-500/20 hover:bg-orange-500/20 transition-colors">📞 हेल्पलाइन नंबर</a>
          </div>
        </div>
      </div>

      <!-- In-Article AdSense Banner -->
      <AdSenseBanner slotType="in-feed" />

      <!-- Official Publisher Attribution & External Read Source -->
      <div class="p-5 rounded-2xl bg-slate-100/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs uppercase font-extrabold text-slate-500 tracking-wider">
            मूल समाचार स्रोत (Source Attribution)
          </span>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            यह समाचार <strong>{article.source}</strong> द्वारा प्रकाशित रिपोर्ट पर आधारित है। विस्तृत विवरण के लिए आप मूल प्रकाशक की वेबसाइट पर भी जा सकते हैं।
          </p>
        </div>

        {article.sourceUrl && (
          <a
            href={article.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-jabalpur-secondary text-white font-bold text-xs whitespace-nowrap transition-all shadow flex items-center gap-1.5 hover:scale-105"
          >
            <span>मूल समाचार पढ़ें ({article.source})</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        )}
      </div>

    </article>

    <!-- Bottom AdSense Banner -->
    <AdSenseBanner slotType="bottom" />

    <!-- Related Stories Section (Keeps users on the site) -->
    <section class="space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>📰</span> {isBusinessCategory ? 'संबंधित बिजनेस व मार्केट समाचार (Related Markets)' : 'संबंधित जबलपुर समाचार (Related Stories)'}
        </h2>
        <a href={isBusinessCategory ? "/business-markets/" : "/#news-grid"} class="text-xs font-bold text-jabalpur-secondary hover:underline">
          {isBusinessCategory ? 'मार्केट्स डेस्क देखें →' : 'सभी समाचार देखें →'}
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relatedArticles.map((rel) => (
          <a
            href={`/news/${rel.slug}/`}
            class="group p-4 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200/80 dark:border-slate-800 hover:border-jabalpur-secondary shadow-sm hover:shadow-lg transition-all flex gap-4 items-center"
          >
            <div class="w-20 h-20 rounded-xl overflow-hidden bg-slate-900 flex-shrink-0">
              <img
                src={rel.imageUrl}
                alt={rel.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=400&q=80';"
              />
            </div>
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-black text-jabalpur-secondary">
                {rel.category}
              </span>
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-jabalpur-secondary transition-colors">
                {rel.title}
              </h3>
              <p class="text-[11px] text-slate-500">{rel.source}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
