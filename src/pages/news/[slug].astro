---
import Layout from '../../layouts/Layout.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import newsData from '../../data/news.json';

export async function getStaticPaths() {
  return newsData.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

// Format dates
const pubDate = new Date(article.publishedAt);
const formattedDate = pubDate.toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Kolkata'
});

const formattedTime = pubDate.toLocaleTimeString('en-IN', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Kolkata'
});

// Related stories from the same or other categories (excluding current)
const relatedArticles = newsData.articles
  .filter((a) => a.id !== article.id)
  .slice(0, 4);

// Canonical & Share URLs
const articleUrl = `https://jabalpuriya.com/news/${article.slug}`;
const whatsappShareText = encodeURIComponent(`⚡ जबलपुर समाचार: ${article.title}\n\nविस्तार से पढ़िए जबलपुरिया पर:\n${articleUrl}`);
const whatsappShareUrl = `https://api.whatsapp.com/send?text=${whatsappShareText}`;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(articleUrl)}&via=jabalpuriya`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`;

const isHindi = /[\u0900-\u097F]/.test(article.title);
---

<Layout
  title={`${article.title} | Jabalpuriya News`}
  description={article.excerpt}
  image={article.imageUrl}
  canonicalUrl={articleUrl}
  type="article"
  publishedTime={article.publishedAt}
  category={article.category}
  keywords={[article.category, 'Jabalpur News', 'जबलपुर समाचार', 'Sanskaardhani', article.source, 'MP News']}
>
  <div class="max-w-4xl mx-auto py-6 sm:py-10 space-y-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center space-x-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 overflow-x-auto pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-jabalpur-secondary transition-colors whitespace-nowrap">Home</a>
      <span>/</span>
      <a href="/#news-grid" class="hover:text-jabalpur-secondary transition-colors whitespace-nowrap">Jabalpur News</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-bold whitespace-nowrap">{article.category}</span>
    </nav>

    <!-- Top Masthead Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Main Article Card -->
    <article class="bg-white dark:bg-[#0c1c33] rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-xl overflow-hidden p-6 sm:p-10 space-y-6">
      
      <!-- Meta & Category Pill Header -->
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3 flex-wrap text-xs">
          <div class="flex items-center gap-2">
            <span class="px-3.5 py-1.5 rounded-full font-black uppercase tracking-wider bg-gradient-to-r from-jabalpur-secondary to-orange-600 text-white shadow-sm">
              {article.category}
            </span>
            <span class="px-3 py-1 rounded-full font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
              ✓ {article.source}
            </span>
          </div>
          <span class="text-slate-500 dark:text-slate-400 font-semibold">
            {article.readTime}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white leading-tight tracking-tight">
          {article.title}
        </h1>

        <!-- Timestamp & Reporter Attribution -->
        <div class="flex items-center justify-between text-xs sm:text-sm text-slate-500 dark:text-slate-400 border-y border-slate-100 dark:border-slate-800/80 py-3 flex-wrap gap-2">
          <div class="flex items-center space-x-2">
            <span>📍 Jabalpur, MP</span>
            <span>•</span>
            <time datetime={article.publishedAt}>{formattedDate} at {formattedTime} IST</time>
          </div>
          <span class="text-jabalpur-secondary font-bold font-hindi">जबलपुरिया न्यूज़ डेस्क</span>
        </div>
      </div>

      <!-- Hero Article Image -->
      <div class="relative rounded-2xl overflow-hidden bg-slate-950 aspect-[16/9] shadow-md">
        <img
          src={article.imageUrl}
          alt={article.title}
          class="w-full h-full object-cover"
          loading="eager"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=1200&q=80';"
        />
        <div class="absolute bottom-2.5 right-2.5 bg-black/60 backdrop-blur-md px-3 py-1 rounded-lg text-[10px] text-white/90">
          Photo: Jabalpur Wire / {article.source}
        </div>
      </div>

      <!-- Viral Social Sharing Actions (WhatsApp Priority) -->
      <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 dark:from-emerald-950/30 dark:via-slate-900 dark:to-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <p class="text-sm font-black text-slate-900 dark:text-white flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-emerald-600">💬</span> यह खबर दोस्तों व परिजनों से साझा करें
          </p>
          <p class="text-xs text-slate-600 dark:text-slate-400">Share this verified story with Jabalpur WhatsApp groups</p>
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-center">
          <a
            href={whatsappShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm flex items-center gap-2 shadow-lg hover:shadow-xl hover:scale-105 transition-all"
            aria-label="Share on WhatsApp"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
            <span>WhatsApp पर शेयर करें</span>
          </a>

          <a
            href={twitterShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-sky-500 transition-colors"
            title="Share on X (Twitter)"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <a
            href={facebookShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-blue-600 transition-colors"
            title="Share on Facebook"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      <!-- Main Article Content & Takeaways -->
      <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg space-y-5">
        
        <!-- Key Highlights Box -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 space-y-2">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
            <span class="text-jabalpur-secondary">⚡</span> मुख्य बिंदु (Key Takeaways)
          </h2>
          <ul class="list-disc pl-5 text-sm space-y-1.5 text-slate-600 dark:text-slate-300">
            <li><strong>क्षेत्र (Location):</strong> जबलपुर (संस्कारधानी), मध्य प्रदेश</li>
            <li><strong>श्रेणी (Category):</strong> {article.category}</li>
            <li><strong>सूचना प्रदाता (Wire Source):</strong> {article.source}</li>
            <li><strong>तिथि व समय:</strong> {formattedDate} ({formattedTime} IST)</li>
          </ul>
        </div>

        <!-- Excerpt Paragraph -->
        <p class="font-medium text-slate-800 dark:text-slate-100 text-lg leading-relaxed">
          {article.excerpt}
        </p>

        <!-- Contextual Insight -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
          संस्कारधानी जबलपुर की नगर विकास, स्मार्ट सिटी परियोजना, प्रशासनिक दिशानिर्देशों और स्थानीय गतिविधियों पर यह ताज़ा अपडेट है। जबलपुरिया पोर्टल पर हम शहर के नागरिकों के लिए प्रामाणिक व सत्यापित समाचार निरंतर प्रस्तुत करते हैं।
        </p>
      </div>

      <!-- In-Article AdSense Banner -->
      <AdSenseBanner slotType="in-feed" />

      <!-- Official Publisher Attribution & External Read Source -->
      <div class="p-5 rounded-2xl bg-slate-100/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs uppercase font-extrabold text-slate-500 tracking-wider">
            स्रोत प्रमाणीकरण (Official Source)
          </span>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            यह समाचार <strong>{article.source}</strong> द्वारा प्रकाशित किया गया है। विस्तृत जानकारी के लिए आप मूल प्रकाशक की वेबसाइट पर भी जा सकते हैं।
          </p>
        </div>

        {article.sourceUrl && (
          <a
            href={article.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-jabalpur-secondary text-white font-bold text-xs whitespace-nowrap transition-all shadow flex items-center gap-1.5 hover:scale-105"
          >
            <span>मूल समाचार पढ़ें ({article.source})</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        )}
      </div>

    </article>

    <!-- Bottom AdSense Banner -->
    <AdSenseBanner slotType="bottom" />

    <!-- Related Jabalpur Stories Section (Keeps users on the site) -->
    <section class="space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>📰</span> संबंधित जबलपुर समाचार (Related Stories)
        </h2>
        <a href="/#news-grid" class="text-xs font-bold text-jabalpur-secondary hover:underline">
          सभी समाचार देखें →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relatedArticles.map((rel) => (
          <a
            href={`/news/${rel.slug}`}
            class="group p-4 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200/80 dark:border-slate-800 hover:border-jabalpur-secondary shadow-sm hover:shadow-lg transition-all flex gap-4 items-center"
          >
            <div class="w-20 h-20 rounded-xl overflow-hidden bg-slate-900 flex-shrink-0">
              <img
                src={rel.imageUrl}
                alt={rel.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=400&q=80';"
              />
            </div>
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-black text-jabalpur-secondary">
                {rel.category}
              </span>
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-jabalpur-secondary transition-colors">
                {rel.title}
              </h3>
              <p class="text-[11px] text-slate-500">{rel.source}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
