---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Feedback | Jabalpuriya.com"
  description="Send your inquiries, news tips, feedback, or advertising requests directly to the Jabalpuriya team via our official form."
>
  <div class="max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <div class="bg-white dark:bg-[#0c1c33] rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xl space-y-8">
      
      <!-- Header -->
      <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
        <span class="px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-jabalpur-secondary/10 text-jabalpur-secondary border border-jabalpur-secondary/20">
          Get in Touch
        </span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Contact Jabalpuriya Desk
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          Have a news tip, suggestion, advertisement inquiry, or civic feedback? Please submit the form below. Your response will be recorded directly into our editorial desk.
        </p>
      </div>

      <!-- Embedded Google Form Container -->
      <div class="w-full rounded-2xl overflow-hidden bg-white border border-slate-200 dark:border-slate-700 shadow-inner flex justify-center">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSc6W_WT3pMHhU2phj_fm4LVIuyRkVHF4jjvWdE3aDeJEuZ5QQ/viewform?embedded=true"
          class="w-full min-h-[880px] sm:min-h-[960px] border-0"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Jabalpuriya Contact and Feedback Form"
        >
          Loading Google Form…
        </iframe>
      </div>

      <!-- Footer Info Strip -->
      <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-3">
        <span>📍 Jabalpur (Sanskaardhani), Madhya Pradesh — 482001</span>
        <a href="/" class="text-jabalpur-secondary font-bold hover:underline flex items-center gap-1">
          ← Back to Jabalpuriya Home
        </a>
      </div>

    </div>
  </div>
</Layout>
