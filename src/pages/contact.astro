---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | Jabalpuriya.com"
  description="Contact the editorial, advertising, and support desk of Jabalpuriya.com in Jabalpur, Madhya Pradesh."
>
  <div class="max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <div class="bg-white dark:bg-[#0c1c33] rounded-3xl border border-slate-200 dark:border-slate-800 p-8 sm:p-12 shadow-xl space-y-8">
      
      <!-- Header -->
      <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
        <span class="px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-jabalpur-secondary/10 text-jabalpur-secondary border border-jabalpur-secondary/20">
          Support & Inquiries
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Contact Us
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          We welcome news suggestions, advertising queries, and feedback from the Jabalpur community.
        </p>
      </div>

      <!-- Contact Details Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-jabalpur-primary text-white flex items-center justify-center text-lg">
            ✉️
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Editorial & News Desk</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            For press releases, news corrections, and editorial feedback:
          </p>
          <a href="mailto:editor@jabalpuriya.com" class="inline-block text-sm font-bold text-jabalpur-secondary underline">
            editor@jabalpuriya.com
          </a>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg">
            💼
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Advertising & Partnerships</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            For sponsored content, advertising slots, and commercial partnerships:
          </p>
          <a href="mailto:contact@jabalpuriya.com" class="inline-block text-sm font-bold text-jabalpur-secondary underline">
            contact@jabalpuriya.com
          </a>
        </div>

      </div>

      <!-- Office & Location -->
      <div class="p-6 rounded-2xl bg-slate-100/70 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 space-y-2 text-sm text-slate-700 dark:text-slate-300">
        <h4 class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
          📍 Jabalpuriya Headquarters
        </h4>
        <p>Jabalpur, Madhya Pradesh, India — 482001</p>
        <p class="text-xs text-slate-500">Operating hours: Monday – Saturday, 9:00 AM – 6:00 PM IST</p>
      </div>

      <div class="pt-6 border-t border-slate-200 dark:border-slate-800 text-center">
        <a href="/" class="inline-flex items-center px-6 py-3 rounded-xl font-bold text-sm bg-jabalpur-primary text-white hover:bg-jabalpur-secondary transition-all shadow-md">
          ← Back to Jabalpuriya Home
        </a>
      </div>

    </div>
  </div>
</Layout>
