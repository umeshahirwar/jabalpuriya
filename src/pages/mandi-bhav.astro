---
import Layout from '../layouts/Layout.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';

const todayDate = new Intl.DateTimeFormat('hi-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  weekday: 'long'
}).format(new Date());

const crops = [
  { name: "सोयाबीन (Soyabean)", variety: "पीला / बोल्ड", min: "₹4,200", max: "₹4,850", modal: "₹4,600", unit: "क्विंटल" },
  { name: "गेहूं (Wheat - लोकवान)", variety: "लोकवान / मिल क्वालिटी", min: "₹2,550", max: "₹2,980", modal: "₹2,780", unit: "क्विंटल" },
  { name: "गेहूं (Wheat - शरबती)", variety: "शरबती प्रीमियम", min: "₹3,400", max: "₹4,250", modal: "₹3,850", unit: "क्विंटल" },
  { name: "धान (Paddy - 1121)", variety: "बासमती 1121", min: "₹3,600", max: "₹4,400", modal: "₹4,100", unit: "क्विंटल" },
  { name: "धान (Paddy - क्रांति)", variety: "मोटा / क्रांति", min: "₹2,183", max: "₹2,350", modal: "₹2,280", unit: "क्विंटल" },
  { name: "चना (Gram - देसी)", variety: "कांटा / देसी", min: "₹5,400", max: "₹6,150", modal: "₹5,800", unit: "क्विंटल" },
  { name: "मटर (Green Peas / Matar)", variety: "जबलपुरी ताजा हरा मटर", min: "₹2,200", max: "₹3,800", modal: "₹3,100", unit: "क्विंटल" },
  { name: "तुअर / अरहर (Pigeon Pea)", variety: "सफेद / लाल देसी", min: "₹7,200", max: "₹9,100", modal: "₹8,400", unit: "क्विंटल" },
  { name: "उड़द (Black Matpe)", variety: "बोल्ड उड़द", min: "₹6,100", max: "₹7,650", modal: "₹7,050", unit: "क्विंटल" },
  { name: "सरसों / राई (Mustard)", variety: "काली सरसों", min: "₹5,100", max: "₹5,850", modal: "₹5,500", unit: "क्विंटल" },
  { name: "मूंग (Green Gram)", variety: "चमकदार मूंग", min: "₹6,800", max: "₹8,200", modal: "₹7,600", unit: "क्विंटल" },
  { name: "मक्का (Maize)", variety: "पीली मक्का", min: "₹1,950", max: "₹2,300", modal: "₹2,150", unit: "क्विंटल" }
];

const bullion = [
  { item: "24 कैरेट सोना (Pure Gold)", rate: "₹88,500 - ₹91,000", unit: "प्रति 10 ग्राम", purity: "99.9% शुद्ध" },
  { item: "22 कैरेट सोना (Jewellery Gold)", rate: "₹81,200 - ₹83,500", unit: "प्रति 10 ग्राम", purity: "91.6% हॉलमार्क" },
  { item: "चांदी (Silver Pure)", rate: "₹96,000 - ₹1,02,000", unit: "प्रति 1 किलोग्राम", purity: "99.9% फाइन" }
];

const faqs = [
  {
    q: "जबलपुर कृषि उपज मंडी प्रांगण कहां स्थित है और खुलने का समय क्या है?",
    a: "जबलपुर मुख्य कृषि उपज मंडी दमोह नाका के समीप कृषि नगर / पाटन रोड क्षेत्र में स्थित है। मंडी सोमवार से शनिवार सुबह 8:00 बजे से शाम 6:00 बजे तक खुली रहती है।"
  },
  {
    q: "जबलपुर मंडी में फसलों की खुली नीलामी (Bidding) किस समय होती है?",
    a: "जबलपुर मंडी में सामान्यतः सुबह 10:30 बजे से दोपहर 2:30 बजे तक पंजीकृत व्यापारियों एवं आढ़तियों द्वारा डाक (खुली नीलामी) बोली लगाई जाती है।"
  },
  {
    q: "क्या जबलपुर मंडी में राष्ट्रीय कृषि बाजार (e-NAM) सुविधा उपलब्ध है?",
    a: "हां, जबलपुर कृषि उपज मंडी ई-नाम (e-NAM) पोर्टल से जुड़ी है। किसान भाई अपनी उपज का गुणवत्ता परीक्षण करवाकर ऑनलाइन बोली के माध्यम से भी विक्रय कर सकते हैं।"
  },
  {
    q: "जबलपुर का हरा मटर (Green Pea) क्यों प्रसिद्ध है?",
    a: "जबलपुर और आसपास के नर्मदा कछार क्षेत्र का मीठा हरा मटर देशभर में प्रसिद्ध है। 'एक जिला एक उत्पाद' (ODOP) के तहत जबलपुर का मटर चिन्हित है और सीजन (नवंबर से फरवरी) में देश के बड़े महानगरों में भेजा जाता है।"
  },
  {
    q: "जबलपुर सराफा बाजार में सोने और चांदी के रेट्स कब तय होते हैं?",
    a: "जबलपुर सराफा एसोसिएशन द्वारा प्रतिदिन दोपहर 12:00 बजे के आसपास राष्ट्रीय व अंतरराष्ट्रीय बुलियन बाजार की दरों के आधार पर स्थानीय भाव निर्धारित किए जाते हैं।"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Jabalpur Mandi Bhav & Gold Silver Rates | जबलपुर मंडी भाव व सराफा रेट्स"
  description="जबलपुर कृषि उपज मंडी में आज के सोयाबीन, गेहूं, धान, चना, मटर, सरसों के न्यूनतम व अधिकतम भाव तथा जबलपुर सराफा बाजार सोना-चांदी लाइव रेट्स।"
  keywords={["Jabalpur Mandi Bhav", "जबलपुर मंडी भाव", "Jabalpur Gold Rate Today", "जबलपुर सराफा भाव", "जबलपुर कृषि उपज मंडी", "Jabalpur Pea Rate", "Soyabean Bhav Jabalpur"]}
>
  <!-- Schema.org FAQ Rich Snippet -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-5xl mx-auto py-6 sm:py-10 space-y-10">
    
    <!-- Hero Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        🌾 कृषि उपज मंडी व सराफा बाजार जबलपुर
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        जबलपुर मंडी भाव व सराफा रेट्स
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        📅 आज का दैनिक बाजार भाव: <span class="font-bold text-slate-800 dark:text-slate-200">{todayDate}</span>
      </p>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        दमोह नाका कृषि उपज मंडी में फसलों (सोयाबीन, गेहूं, चना, मटर, धान) के नीलामी भाव एवं जबलपुर सराफा संघ अनुसार सोने-चांदी के ताजा भाव।
      </p>

      <!-- WhatsApp Share Bar -->
      <div class="pt-2 flex justify-center">
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent('🌾 जबलपुर कृषि उपज मंडी भाव और सराफा सोना-चांदी रेट्स आज के देखें:\nhttps://jabalpuriya.com/mandi-bhav')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-lg hover:scale-105 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          <span>किसान भाइयों व मित्रों के साथ शेयर करें</span>
        </a>
      </div>
    </header>

    <!-- Top Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Mandi Crop Rates Table Section -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
            <span>🚜</span> जबलपुर कृषि उपज मंडी - फसल भाव
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            दमोह नाका / पाटन रोड मंडी में दैनिक नीलामी औसत दरें
          </p>
        </div>
        <div class="text-xs px-3 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold rounded-lg border border-emerald-500/20 w-fit">
          दरें: ₹ प्रति क्विंटल
        </div>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm bg-white dark:bg-[#0c1c33]">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-100 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 font-black uppercase text-[11px] tracking-wider border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th scope="col" class="py-3.5 px-4 sm:px-6">जिंस / फसल (Crop)</th>
              <th scope="col" class="py-3.5 px-3 sm:px-4">किस्म (Variety)</th>
              <th scope="col" class="py-3.5 px-3 sm:px-4 text-rose-600 dark:text-rose-400">न्यूनतम भाव</th>
              <th scope="col" class="py-3.5 px-3 sm:px-4 text-emerald-600 dark:text-emerald-400">अधिकतम भाव</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6 text-sky-600 dark:text-sky-400 font-black">मॉडल (औसत) भाव</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-200">
            {crops.map((c) => (
              <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                <td class="py-3.5 px-4 sm:px-6 font-bold text-slate-900 dark:text-white">
                  {c.name}
                </td>
                <td class="py-3.5 px-3 sm:px-4 text-slate-500 dark:text-slate-400">
                  {c.variety}
                </td>
                <td class="py-3.5 px-3 sm:px-4 font-semibold text-rose-600 dark:text-rose-400">
                  {c.min}
                </td>
                <td class="py-3.5 px-3 sm:px-4 font-semibold text-emerald-600 dark:text-emerald-400">
                  {c.max}
                </td>
                <td class="py-3.5 px-4 sm:px-6 font-black text-sky-600 dark:text-sky-400 text-sm sm:text-base">
                  {c.modal}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[11px] text-slate-400 italic">
        * नोट: मंडी भाव फसल की गुणवत्ता, नमी (Moisture), कचरा प्रतिशत एवं दैनिक आवक के आधार पर नीलामी में परिवर्तित हो सकते हैं।
      </p>
    </section>

    <!-- Mid Ad Placement -->
    <AdSenseBanner slotType="content" />

    <!-- Bullion & Sarafa Bazar Section -->
    <section class="space-y-4">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>💍</span> जबलपुर सराफा बाजार - सोना व चांदी भाव
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          बड़ा फुहारा व लार्डगंज सराफा बाजार आधारित अनुमानित दरें (बिना जीएसटी/मेकिंग चार्ज)
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {bullion.map((b) => (
          <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-lg space-y-2 relative overflow-hidden group hover:border-amber-400/50 transition-all">
            <div class="text-xs font-black uppercase text-amber-600 dark:text-amber-400 tracking-wider">
              {b.purity}
            </div>
            <h3 class="text-lg font-black text-slate-900 dark:text-white">
              {b.item}
            </h3>
            <div class="text-2xl sm:text-3xl font-black text-amber-500 dark:text-amber-400">
              {b.rate}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold">
              {b.unit}
            </div>
          </div>
        ))}
      </div>
      <p class="text-[11px] text-slate-400 italic">
        * सराफा नोट: ज्वैलरी खरीद पर 3% जीएसटी और ज्वैलर्स मेकिंग चार्ज अतिरिक्त लागू होता है। खरीद से पहले हॉलमार्क अवश्य चेक करें।
      </p>
    </section>

    <!-- Key Mandi Info & Facilities -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-2">
        <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>📍</span> मंडी पता एवं संपर्क
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          <strong>कार्यालय:</strong> कृषि उपज मंडी समिति, दमोह नाका, पाटन रोड, जबलपुर (म.प्र.) 482002<br/>
          <strong>नीलामी समय:</strong> प्रातः 10:30 बजे से अपरान्ह 02:30 बजे तक (रविवार अवकाश)<br/>
          <strong>किसान सुविधा केंद्र:</strong> तौल पर्ची, कैंटीन, किसान विश्राम गृह एवं पेय जल व्यवस्था उपलब्ध।
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-2">
        <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span>📱</span> किसान भाई आवश्यक लिंक्स व पोर्टल
        </h3>
        <ul class="text-xs space-y-1.5 text-slate-600 dark:text-slate-300">
          <li>• <strong>e-NAM पोर्टल:</strong> <a href="https://enam.gov.in" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 underline font-semibold">enam.gov.in</a></li>
          <li>• <strong>मध्य प्रदेश किसान कल्याण:</strong> mpkrishi.mp.gov.in</li>
          <li>• <strong>किसान कॉल सेंटर टोल-फ्री:</strong> <a href="tel:18001801551" class="text-emerald-600 dark:text-emerald-400 font-bold">1800-180-1551</a></li>
        </ul>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) -->
    <section class="space-y-6 pt-4">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          अक्सर पूछे जाने वाले प्रश्न (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          जबलपुर मंडी और सराफा बाजार से जुड़े प्रमुख सवाल
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((f, i) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-white flex items-start gap-2">
              <span class="text-amber-500 font-black">Q{i + 1}.</span>
              <span>{f.q}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-6">
              {f.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom WhatsApp & Navigation CTA -->
    <div class="p-6 rounded-3xl bg-gradient-to-r from-emerald-600 to-teal-700 text-white text-center space-y-4 shadow-xl">
      <h3 class="text-xl sm:text-2xl font-black">
        जबलपुर के किसान भाइयों और व्यापारियों तक पहुंचाएं
      </h3>
      <p class="text-xs sm:text-sm text-emerald-100 max-w-xl mx-auto">
        दैनिक मंडी भाव और सराफा रेट्स अपने किसान ग्रुप्स और दोस्तों में शेयर करें ताकि सभी को सही बाजार भाव मिल सके।
      </p>
      <a
        href={`https://api.whatsapp.com/send?text=${encodeURIComponent('🌾 जबलपुर मंडी भाव व सराफा सोना-चांदी रेट्स देखें:\nhttps://jabalpuriya.com/mandi-bhav')}`}
        target="_blank"
        rel="noopener noreferrer"
