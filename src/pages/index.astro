---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import CommunitySpotlight from '../components/CommunitySpotlight.astro';
import RashifalSection from '../components/RashifalSection.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';
import newsData from '../data/news.json';

// Partition news data
const featuredArticle = newsData.articles.find(a => a.isFeatured) || newsData.articles[0];
const regularArticles = newsData.articles.filter(a => a.id !== featuredArticle.id);

// Extract distinct categories
const categories = ['All', 'Smart City & Infra', 'Culture & Tourism', 'Education & Tech', 'Business & Jobs', 'Local News', 'Rashifal'];

const lastUpdatedFormatted = new Date(newsData.lastUpdated).toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Kolkata'
});
---

<Layout
  title="Jabalpuriya.com | Jabalpur's #1 News & Community Portal"
  description="Real-time Jabalpur local news, breaking headlines, smart city developments, daily & annual Rashifal, Bhedaghat tourism guide, and verified reporting."
>
  <div class="space-y-12">
    
    <!-- Top Masthead Leaderboard Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Hero Section: Top Breaking Headline & Live Weather Snapshot -->
    <section class="space-y-6 pt-1">
      
      <!-- Top Alert Ribbon -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white dark:bg-[#0c1c33] px-5 py-3 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm gap-2">
        <div class="flex items-center space-x-2.5 text-xs">
          <span class="px-2.5 py-1 rounded-md bg-gradient-to-r from-red-600 to-red-500 text-white font-black tracking-wide uppercase shadow-sm">
            ⚡ Jabalpur Top Story
          </span>
          <a href={`/news/${featuredArticle.slug}`} class="text-slate-800 dark:text-slate-200 font-bold truncate max-w-xl hover:text-jabalpur-secondary transition-colors">
            {featuredArticle.title}
          </a>
        </div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">
          Updated: {lastUpdatedFormatted} IST
        </div>
      </div>

      <!-- Main Hero Grid: Featured Story + Weather & Fast Access -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        
        <!-- Large Featured Story Banner (2 Cols) -->
        <div class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-slate-950 border border-slate-800 shadow-2xl min-h-[420px] sm:min-h-[480px] flex flex-col justify-end p-6 sm:p-10">
          <img
            src={featuredArticle.imageUrl}
            alt={featuredArticle.title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out opacity-85"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1545459720-aac8509eb02c?auto=format&fit=crop&w=1200&q=80';"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>

          <!-- Hero Story Details -->
          <div class="relative z-10 space-y-4 max-w-2xl">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-jabalpur-secondary to-orange-600 text-white shadow-lg">
                ★ Top Breaking Story
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/20 backdrop-blur-md text-white border border-white/20">
                {featuredArticle.category}
              </span>
              <span class="text-xs text-slate-300 flex items-center gap-1 font-semibold">
                • {featuredArticle.source}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white leading-tight drop-shadow-md">
              <a href={`/news/${featuredArticle.slug}`} class="hover:underline focus:outline-none">
                {featuredArticle.title}
              </a>
            </h1>

            <p class="text-slate-200 text-sm sm:text-base leading-relaxed line-clamp-3 font-medium">
              {featuredArticle.excerpt}
            </p>

            <div class="pt-3 flex items-center justify-between text-xs text-slate-300 gap-2 flex-wrap">
              <div class="flex items-center gap-2.5">
                <a
                  href={`/news/${featuredArticle.slug}`}
                  class="inline-flex items-center px-5 py-2.5 rounded-xl font-black text-sm bg-white text-slate-950 hover:bg-slate-100 transition-all shadow-lg hover:scale-105"
                >
                  Read Full Coverage
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>

                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`⚡ जबलपुर मुख्य समाचार: ${featuredArticle.title}\n\nविस्तार से पढ़िए जबलपुरिया पर:\nhttps://jabalpuriya.com/news/${featuredArticle.slug}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md hover:scale-105 transition-all"
                  title="Share on WhatsApp"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                  </svg>
                  <span>Share</span>
                </a>
              </div>
              <span class="bg-black/40 px-3 py-1 rounded-lg backdrop-blur-sm border border-white/10 font-bold">{featuredArticle.readTime}</span>
            </div>
          </div>
        </div>

        <!-- Right Side: Weather & Quick City Links (1 Col) -->
        <div class="flex flex-col gap-6 justify-between">
          <WeatherWidget />

          <!-- Quick Services Menu -->
          <div class="bg-white dark:bg-[#0c1c33] p-6 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-md space-y-4">
            <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-jabalpur-secondary">⚡</span> Jabalpur Quick Connect
            </h3>
            
            <div class="grid grid-cols-2 gap-2.5 text-xs font-bold">
              <a href="/rashifal" class="p-3 rounded-2xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-800 dark:text-amber-300 transition-all flex items-center gap-2 border border-amber-300/40 dark:border-amber-700/40 shadow-sm hover:scale-[1.02]">
                <span class="text-base">✨</span> आज का राशिफल
              </a>
              <a href="/mandi-bhav" class="p-3 rounded-2xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 transition-all flex items-center gap-2 border border-emerald-300/40 dark:border-emerald-700/40 shadow-sm hover:scale-[1.02]">
                <span class="text-base">🌾</span> मंडी व सराफा भाव
              </a>
              <a href="/bhedaghat-guide" class="p-3 rounded-2xl bg-sky-500/10 hover:bg-sky-500/20 text-sky-800 dark:text-sky-300 transition-all flex items-center gap-2 border border-sky-300/40 dark:border-sky-700/40 shadow-sm hover:scale-[1.02]">
                <span class="text-base">🏛️</span> भेड़ाघाट गाइड
              </a>
              <a href="/gwarighat-aarti" class="p-3 rounded-2xl bg-teal-500/10 hover:bg-teal-500/20 text-teal-800 dark:text-teal-300 transition-all flex items-center gap-2 border border-teal-300/40 dark:border-teal-700/40 shadow-sm hover:scale-[1.02]">
                <span class="text-base">🌊</span> ग्वारीघाट आरती
              </a>
              <a href="/helplines" class="p-3 rounded-2xl bg-orange-500/10 hover:bg-orange-500/20 text-orange-800 dark:text-orange-300 transition-all flex items-center gap-2 border border-orange-300/40 dark:border-orange-700/40 shadow-sm hover:scale-[1.02]">
                <span class="text-base">📞</span> आपात हेल्पलाइन
              </a>
              <a href="#news-grid" class="p-3 rounded-2xl bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800 dark:text-slate-200 transition-all flex items-center gap-2 border border-slate-200/60 dark:border-slate-700/60 shadow-sm hover:scale-[1.02]">
                <span class="text-base">🚌</span> लोकल समाचार
              </a>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] font-semibold text-slate-500 flex items-center justify-between">
              <span>District Code: MP-20</span>
              <span>PIN: 482001 - 482056</span>
            </div>
          </div>

          <!-- Right Sidebar AdSense Slot (300x250) -->
          <AdSenseBanner slotType="sidebar" />
        </div>

      </div>
    </section>

    <!-- News Feed Section with Interactive Category Filter & Unlimited Scroll -->
    <section id="news-grid" class="space-y-6 pt-4">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-jabalpur-secondary/10 text-jabalpur-secondary border border-jabalpur-secondary/20">
            📡 24x7 Live Feed
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight mt-1.5">
            Latest Jabalpur News Wire
          </h2>
        </div>

        <!-- Filter Pill Buttons -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full" id="category-filter-bar">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat}
              class={`category-btn px-4 py-2 rounded-2xl text-xs font-black whitespace-nowrap transition-all duration-200 cursor-pointer ${
                idx === 0
                  ? 'bg-gradient-to-r from-jabalpur-primary to-jabalpur-700 text-white shadow-md'
                  : 'bg-white dark:bg-[#0c1c33] text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700 hover:border-jabalpur-secondary hover:text-jabalpur-secondary'
              }`}
            >
              {cat === 'Rashifal' ? '✨ Rashifal (राशिफल)' : cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Articles Grid Container -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="articles-container">
        {regularArticles.map((article, idx) => (
          <div class="news-item-wrapper" data-index={idx}>
            <NewsCard {...article} />
          </div>
        ))}
      </div>

      <!-- No items fallback -->
      <div id="no-articles-msg" class="hidden py-16 text-center text-slate-500">
        <p class="text-lg font-bold">No stories found in this category right now.</p>
        <p class="text-sm mt-1">
          For daily and annual predictions, please check our <a href="#rashifal" class="text-jabalpur-secondary underline font-bold">Rashifal Section</a>.
        </p>
      </div>

      <!-- Unlimited Scroll Sentinel & Load More Control -->
      <div id="infinite-scroll-sentinel" class="py-8 flex flex-col items-center justify-center">
        <div id="loading-spinner" class="hidden flex items-center space-x-2 text-jabalpur-secondary font-bold text-sm">
          <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Loading more Jabalpur stories...</span>
        </div>
        
        <button
          id="load-more-btn"
          type="button"
          class="px-6 py-3 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-700 hover:border-jabalpur-secondary text-slate-800 dark:text-slate-200 font-black text-sm shadow-md hover:shadow-xl transition-all duration-200 hover:scale-105 flex items-center gap-2"
        >
          <span>Load More News Stories</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <p id="all-loaded-msg" class="hidden text-xs text-slate-400 font-bold uppercase tracking-wider mt-4">
          ✓ You are caught up with all latest Jabalpur stories
        </p>
      </div>

    </section>

    <!-- Rashifal (Horoscope) Section: Annual & Daily Vedic Predictions -->
    <RashifalSection />

    <!-- Cultural Showcase Section -->
    <CommunitySpotlight />

    <!-- Bottom In-Feed / Sticky Responsive Ad Placement -->
    <AdSenseBanner slotType="bottom" />

  </div>
</Layout>

<script>
  // Unlimited / Infinite Scroll & Category Filtering Implementation
  const BATCH_SIZE = 6;
  let currentlyVisible = 9; // Initial visible stories
  let activeCategory = 'All';

  const filterBtns = document.querySelectorAll('.category-btn');
  const wrappers = Array.from(document.querySelectorAll('.news-item-wrapper'));
  const noArticlesMsg = document.getElementById('no-articles-msg');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const allLoadedMsg = document.getElementById('all-loaded-msg');
  const sentinel = document.getElementById('infinite-scroll-sentinel');
  const loadingSpinner = document.getElementById('loading-spinner');

  function updateNewsVisibility() {
    let matchingWrappers = wrappers.filter(wrapper => {
      const article = wrapper.querySelector('article');
      if (!article) return false;
      const cat = article.getAttribute('data-category');
      return activeCategory === 'All' || cat === activeCategory;
    });

    // Show/Hide based on batch index
    let count = 0;
    matchingWrappers.forEach((wrapper, index) => {
      if (index < currentlyVisible) {
        (wrapper as HTMLElement).style.display = 'block';
        count++;
      } else {
        (wrapper as HTMLElement).style.display = 'none';
      }
    });

    // Handle empty category state
    if (noArticlesMsg) {
      if (count === 0) {
        noArticlesMsg.classList.remove('hidden');
      } else {
        noArticlesMsg.classList.add('hidden');
      }
    }

    // Toggle Load More & End of Feed messages
    if (loadMoreBtn && allLoadedMsg) {
      if (currentlyVisible >= matchingWrappers.length || matchingWrappers.length <= BATCH_SIZE) {
        loadMoreBtn.classList.add('hidden');
        if (matchingWrappers.length > 0) {
          allLoadedMsg.classList.remove('hidden');
        } else {
          allLoadedMsg.classList.add('hidden');
        }
      } else {
        loadMoreBtn.classList.remove('hidden');
        allLoadedMsg.classList.add('hidden');
      }
    }
  }

  // Load next chunk of articles
  function loadMoreArticles() {
    if (loadingSpinner) loadingSpinner.classList.remove('hidden');
    if (loadMoreBtn) loadMoreBtn.classList.add('hidden');

    setTimeout(() => {
      currentlyVisible += BATCH_SIZE;
      updateNewsVisibility();
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
    }, 250);
  }

  // Click handler for button
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadMoreArticles);
  }

  // Infinite Scroll Intersection Observer
  if (sentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const matchingWrappers = wrappers.filter(wrapper => {
            const article = wrapper.querySelector('article');
            if (!article) return false;
            const cat = article.getAttribute('data-category');
            return activeCategory === 'All' || cat === activeCategory;
          });

          if (currentlyVisible < matchingWrappers.length) {
            loadMoreArticles();
          }
        }
      });
    }, { rootMargin: '300px' });

    observer.observe(sentinel);
  }

  // Category Filter clicks
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-filter') || 'All';
      
      // Update Button Styles
      filterBtns.forEach(b => {
        b.classList.remove('bg-gradient-to-r', 'from-jabalpur-primary', 'to-jabalpur-700', 'text-white', 'shadow-md');
        b.classList.add('bg-white', 'dark:bg-[#0c1c33]', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200/80', 'dark:border-slate-700');
      });
      btn.classList.add('bg-gradient-to-r', 'from-jabalpur-primary', 'to-jabalpur-700', 'text-white', 'shadow-md');
      btn.classList.remove('bg-white', 'dark:bg-[#0c1c33]', 'text-slate-700', 'dark:text-slate-300');

      if (category === 'Rashifal') {
        const rashifalEl = document.getElementById('rashifal');
        if (rashifalEl) {
          rashifalEl.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }

      activeCategory = category;
      currentlyVisible = 9; // Reset pagination for category
      updateNewsVisibility();
    });
  });

  // Initial call
  updateNewsVisibility();
</script>
