---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import CommunitySpotlight from '../components/CommunitySpotlight.astro';
import RashifalSection from '../components/RashifalSection.astro';
import newsData from '../data/news.json';

// Partition news data
const featuredArticle = newsData.articles.find(a => a.isFeatured) || newsData.articles[0];
const regularArticles = newsData.articles.filter(a => a.id !== featuredArticle.id);

// Extract distinct categories
const categories = ['All', 'Rashifal', ...new Set(newsData.articles.map(a => a.category))];

const lastUpdatedFormatted = new Date(newsData.lastUpdated).toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Kolkata'
});
---

<Layout
  title="Jabalpuriya.com | Jabalpur News, Breaking Updates, Rashifal & City Guide"
  description="Discover the latest Jabalpur news, MP smart city projects, daily & annual Rashifal (Horoscope), Bhedaghat tourism updates, and verified editorial reporting on Jabalpuriya."
>
  <div class="space-y-12">
    
    <!-- Hero Section: Top Breaking Story & Live Weather Snapshot -->
    <section class="space-y-6">
      
      <!-- Top Alert Ribbon -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white dark:bg-[#0f2139] px-4 py-3 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm gap-2">
        <div class="flex items-center space-x-2 text-xs">
          <span class="px-2 py-0.5 rounded bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 font-extrabold tracking-wide uppercase">
            ⚡ Jabalpur Top Wire
          </span>
          <span class="text-slate-600 dark:text-slate-300 font-medium truncate">
            {featuredArticle.title}
          </span>
        </div>
        <div class="text-[11px] text-slate-400 whitespace-nowrap">
          Updated: {lastUpdatedFormatted} IST
        </div>
      </div>

      <!-- Main Hero Grid: Featured Headline + Weather & Quick Stats -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        
        <!-- Large Featured Story Banner (2 Cols) -->
        <div class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-slate-900 border border-slate-800 shadow-xl min-h-[380px] sm:min-h-[460px] flex flex-col justify-end p-6 sm:p-10">
          <img
            src={featuredArticle.imageUrl}
            alt={featuredArticle.title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>

          <!-- Hero Story Details -->
          <div class="relative z-10 space-y-4 max-w-2xl">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-jabalpur-secondary text-white shadow-lg">
                ★ Breaking Headline
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-md text-white border border-white/20">
                {featuredArticle.category}
              </span>
              <span class="text-xs text-slate-300 flex items-center gap-1 font-medium">
                • {featuredArticle.source}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight drop-shadow-md">
              <a href={featuredArticle.sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:underline focus:outline-none">
                {featuredArticle.title}
              </a>
            </h1>

            <p class="text-slate-200 text-sm sm:text-base leading-relaxed line-clamp-3">
              {featuredArticle.excerpt}
            </p>

            <div class="pt-2 flex items-center justify-between text-xs text-slate-300">
              <a
                href={featuredArticle.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-5 py-2.5 rounded-xl font-bold bg-white text-jabalpur-950 hover:bg-slate-100 transition-colors shadow"
              >
                Read Full Story
                <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <span>{featuredArticle.readTime}</span>
            </div>
          </div>
        </div>

        <!-- Right Side: Weather, Helplines & City Metrics (1 Col) -->
        <div class="flex flex-col gap-6 justify-between">
          <WeatherWidget />

          <!-- Jabalpur Community Fast Links -->
          <div class="bg-white dark:bg-[#0f2139] p-5 sm:p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="text-jabalpur-secondary">📍</span> City Quick Services
            </h3>
            
            <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
              <a href="#rashifal" class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 hover:bg-amber-100 dark:hover:bg-amber-900/60 text-amber-900 dark:text-amber-300 transition-colors flex items-center gap-1.5 border border-amber-200/50 dark:border-amber-900/50">
                <span>✨</span> आज का राशिफल
              </a>
              <a href="#news-grid" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 hover:bg-jabalpur-50 dark:hover:bg-jabalpur-900/40 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5">
                <span>🚌</span> City Bus Routes
              </a>
              <a href="#culture" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 hover:bg-jabalpur-50 dark:hover:bg-jabalpur-900/40 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5">
                <span>🌊</span> Gwarighat Aarti
              </a>
              <a href="#editorial-desk" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 hover:bg-jabalpur-50 dark:hover:bg-jabalpur-900/40 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5">
                <span>📰</span> Press Desk
              </a>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-500 flex items-center justify-between">
              <span>District Code: MP-20</span>
              <span>PIN: 482001 - 482056</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- News Feed Section with Interactive Category Filter -->
    <section id="news-grid" class="space-y-6 pt-4">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-jabalpur-secondary">
            Verified City Journalism
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
            Latest Jabalpur News & Wire
          </h2>
        </div>

        <!-- Filter Pill Buttons -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full" id="category-filter-bar">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat}
              class={`category-btn px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all duration-200 cursor-pointer ${
                idx === 0
                  ? 'bg-jabalpur-primary text-white shadow-sm'
                  : 'bg-slate-200/80 text-slate-700 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
              }`}
            >
              {cat === 'Rashifal' ? '✨ Rashifal (राशिफल)' : cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="articles-container">
        {regularArticles.map((article) => (
          <NewsCard {...article} />
        ))}
      </div>

      <!-- No items fallback -->
      <div id="no-articles-msg" class="hidden py-12 text-center text-slate-500">
        <p class="text-base font-semibold">No stories found in this category currently.</p>
        <p class="text-xs mt-1">
          For astrology and horoscope updates, please explore our dedicated <a href="#rashifal" class="text-jabalpur-primary underline font-bold">Rashifal Section</a> below.
        </p>
      </div>
    </section>

    <!-- Rashifal (Horoscope) Section: Annual & Daily Vedic Predictions -->
    <RashifalSection />

    <!-- Cultural Showcase Section -->
    <CommunitySpotlight />

    <!-- Editorial Desk: Verified News Tip & Press Release Submission (Moderated with strict Brand Safety Guidelines) -->
    <section id="editorial-desk" class="my-16 bg-gradient-to-r from-jabalpur-950 via-[#0d223d] to-jabalpur-950 text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        
        <!-- Editorial Guidance & Brand Safety Protocol -->
        <div class="space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            🛡️ Strict Editorial Verification & Brand Safety
          </div>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight leading-snug">
            Jabalpuriya Editorial Verification Desk
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            To preserve journalistic integrity and maintain 100% brand safety for the citizens of Jabalpur, <strong>Jabalpuriya.com does not permit unmoderated open posting</strong>.
          </p>
          
          <div class="space-y-3 pt-1 text-xs text-slate-300">
            <div class="flex items-start space-x-3 bg-white/5 p-3 rounded-xl border border-white/5">
              <span class="text-emerald-400 font-bold text-sm">✓</span>
              <p><strong>100% Human Editorial Review:</strong> Every tip, press release, and event submission is fact-checked and verified by our editorial desk before publication.</p>
            </div>
            <div class="flex items-start space-x-3 bg-white/5 p-3 rounded-xl border border-white/5">
              <span class="text-emerald-400 font-bold text-sm">✓</span>
              <p><strong>Anti-Spam & Brand Safety:</strong> Promotional spam, unverified rumors, defamatory claims, or uncorroborated allegations are automatically rejected.</p>
            </div>
            <div class="flex items-start space-x-3 bg-white/5 p-3 rounded-xl border border-white/5">
              <span class="text-emerald-400 font-bold text-sm">✓</span>
              <p><strong>Source Protection:</strong> Confidential news tips are handled under strict journalistic confidentiality standards.</p>
            </div>
          </div>
        </div>

        <!-- Moderated Submission Form -->
        <div class="bg-white/5 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-white/10 space-y-4">
          <div class="border-b border-white/10 pb-3">
            <h3 class="text-lg font-bold text-white">Submit News Tip / Press Release</h3>
            <p class="text-xs text-slate-400">All submissions are queued for editorial verification prior to publication.</p>
          </div>

          <form class="space-y-3.5" onsubmit="event.preventDefault(); alert('Thank you. Your submission has been securely transmitted to the Jabalpuriya Editorial Desk for verification.'); this.reset();">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="tip-sender-name" class="block text-xs font-medium text-slate-300 mb-1">Full Name / Organization</label>
                <input type="text" id="tip-sender-name" required placeholder="e.g. Dr. Rajesh Sharma" class="w-full px-3.5 py-2 rounded-lg bg-slate-900/80 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-jabalpur-500" />
              </div>
              <div>
                <label for="tip-contact" class="block text-xs font-medium text-slate-300 mb-1">Official Email or Phone</label>
                <input type="text" id="tip-contact" required placeholder="contact@domain.com" class="w-full px-3.5 py-2 rounded-lg bg-slate-900/80 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-jabalpur-500" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="tip-category" class="block text-xs font-medium text-slate-300 mb-1">Category</label>
                <select id="tip-category" class="w-full px-3.5 py-2 rounded-lg bg-slate-900/80 border border-slate-700 text-sm text-white focus:outline-none focus:ring-2 focus:ring-jabalpur-500">
                  <option value="civic">Civic & Infrastructure</option>
                  <option value="events">Cultural / Community Event</option>
                  <option value="education">Education & Academic</option>
                  <option value="business">Business & Industry</option>
                  <option value="other">General City News</option>
                </select>
              </div>
              <div>
                <label for="tip-location" class="block text-xs font-medium text-slate-300 mb-1">Location in Jabalpur</label>
                <input type="text" id="tip-location" required placeholder="e.g. Civil Lines / Gwarighat" class="w-full px-3.5 py-2 rounded-lg bg-slate-900/80 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-jabalpur-500" />
              </div>
            </div>

            <div>
              <label for="tip-details" class="block text-xs font-medium text-slate-300 mb-1">News Details & Source Evidence</label>
              <textarea id="tip-details" rows="3" required placeholder="Provide clear facts, dates, context, and official references..." class="w-full px-3.5 py-2 rounded-lg bg-slate-900/80 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-jabalpur-500"></textarea>
            </div>

            <div class="flex items-center space-x-2 pt-1">
              <input type="checkbox" id="verify-consent" required class="rounded bg-slate-900 border-slate-700 text-jabalpur-secondary focus:ring-jabalpur-500 h-4 w-4" />
              <label for="verify-consent" class="text-[11px] text-slate-300">
                I confirm this information is accurate and agree to human editorial verification before publication.
              </label>
            </div>

            <button type="submit" class="w-full py-2.5 bg-jabalpur-secondary hover:bg-[#c84d22] font-bold text-sm rounded-lg transition-colors shadow">
              Submit for Editorial Verification
            </button>
          </form>
        </div>

      </div>
    </section>

  </div>
</Layout>

<script>
  // Category filtering logic
  const filterBtns = document.querySelectorAll('.category-btn');
  const articles = document.querySelectorAll('#articles-container article');
  const noArticlesMsg = document.getElementById('no-articles-msg');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-filter');
      
      // Update button styles
      filterBtns.forEach(b => {
        b.classList.remove('bg-jabalpur-primary', 'text-white', 'shadow-sm');
        b.classList.add('bg-slate-200/80', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
      });
      btn.classList.add('bg-jabalpur-primary', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-slate-200/80', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');

      if (category === 'Rashifal') {
        const rashifalEl = document.getElementById('rashifal');
        if (rashifalEl) {
          rashifalEl.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }

      // Filter articles
      let visibleCount = 0;
      articles.forEach(article => {
        const itemCategory = article.getAttribute('data-category');
        if (category === 'All' || itemCategory === category) {
          (article as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (article as HTMLElement).style.display = 'none';
        }
      });

      // Handle empty state
      if (noArticlesMsg) {
        if (visibleCount === 0) {
          noArticlesMsg.classList.remove('hidden');
        } else {
          noArticlesMsg.classList.add('hidden');
        }
      }
    });
  });
</script>
