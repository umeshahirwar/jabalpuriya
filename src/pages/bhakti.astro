<!-- Client Script: Interactive Calendar Month Switching & Day Clicking -->
<script is:inline define:vars={{ monthsData: bhaktiData.months }}>
  let currentMonthIdx = 10; // Default: November (0-indexed: 10)
  const monthSelect = document.getElementById('month-select');
  const monthTitle = document.getElementById('active-month-title');
  const daysGrid = document.getElementById('calendar-days-grid');

  // Inspector Elements
  const inspDate = document.getElementById('inspector-date-str');
  const inspTithi = document.getElementById('inspector-weekday-tithi');
  const inspFestContainer = document.getElementById('inspector-festival-container');
  const inspFestName = document.getElementById('inspector-festival-name');
  const inspFoodRule = document.getElementById('inspector-food-rule');
  const inspAbhijit = document.getElementById('inspector-abhijit');
  const inspRahu = document.getElementById('inspector-rahu');
  const inspSnan = document.getElementById('inspector-snan');

  function renderCalendar(monthIdx) {
    if (!daysGrid) return;
    const month = monthsData[monthIdx];
    if (!month) return;

    if (monthTitle) {
      monthTitle.textContent = `${month.hindiName} (${month.hinduMonth})`;
    }

    daysGrid.innerHTML = '';

    // In JS/Python, firstDayWeekday: 0=Mon, 6=Sun. 
    // In our UI: Col 0=Sun, Col 1=Mon ... Col 6=Sat.
    // Sunday offset conversion:
    const sunOffset = (month.firstDayWeekday + 1) % 7;

    // Blank cells before day 1
    for (let i = 0; i < sunOffset; i++) {
      const blank = document.createElement('div');
      blank.className = 'p-2 rounded-xl bg-slate-50/50 dark:bg-slate-800/20 opacity-30 pointer-events-none min-h-[56px] sm:min-h-[68px]';
      daysGrid.appendChild(blank);
    }

    // Days cells
    month.days.forEach((dayObj) => {
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.setAttribute('data-date', dayObj.date);
      
      const isToday = dayObj.date === '2026-11-23';
      const hasFest = !!dayObj.festival;
      const isVrat = dayObj.isVrat;

      let borderClass = 'border-slate-200/80 dark:border-slate-700/80';
      let bgClass = 'bg-white dark:bg-[#0c1c33] text-slate-800 dark:text-slate-100';

      if (isToday) {
        borderClass = 'border-2 border-amber-500 shadow-md';
        bgClass = 'bg-amber-500/15 dark:bg-amber-950/60 font-black';
      } else if (hasFest) {
        borderClass = 'border-amber-400/80 dark:border-amber-600/80';
        bgClass = 'bg-amber-50/80 dark:bg-amber-950/30';
      } else if (isVrat) {
        borderClass = 'border-red-300 dark:border-red-900';
        bgClass = 'bg-red-50/50 dark:bg-red-950/20';
      }

      cell.className = `p-1.5 sm:p-2 rounded-xl text-left border ${borderClass} ${bgClass} hover:border-amber-500 transition-all flex flex-col justify-between min-h-[56px] sm:min-h-[68px] cursor-pointer group`;

      cell.innerHTML = `
        <div class="flex items-center justify-between w-full">
          <span class="text-xs sm:text-sm font-black">${dayObj.day}</span>
          ${hasFest ? '<span class="w-2 h-2 rounded-full bg-emerald-500"></span>' : isVrat ? '<span class="w-2 h-2 rounded-full bg-amber-500"></span>' : ''}
        </div>
        <div class="w-full">
          <span class="text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 truncate block font-bold leading-tight">
            ${dayObj.tithi}
          </span>
          ${hasFest ? `<span class="text-[8px] sm:text-[9px] font-extrabold text-amber-700 dark:text-amber-400 truncate block mt-0.5">🚩 ${dayObj.festival.split(' ')[0]}</span>` : ''}
        </div>
      `;

      cell.addEventListener('click', () => {
        selectDay(dayObj);
      });

      daysGrid.appendChild(cell);
    });
  }

  function selectDay(dayObj) {
    if (!inspDate) return;
    
    // Format date string
    const dateParts = dayObj.date.split('-');
    const formatted = `${dateParts[2]} ${getMonthNameHindi(parseInt(dateParts[1]))} ${dateParts[0]}`;

    inspDate.textContent = formatted;
    inspTithi.textContent = `${dayObj.weekday} | ${dayObj.tithi}`;

    if (dayObj.festival) {
      if (inspFestContainer) inspFestContainer.classList.remove('hidden');
      if (inspFestName) inspFestName.textContent = dayObj.festival;
    } else {
      if (inspFestContainer) inspFestContainer.classList.add('hidden');
    }

    if (inspFoodRule) inspFoodRule.textContent = dayObj.foodRule;
    if (inspAbhijit) inspAbhijit.textContent = dayObj.abhijitMuhurat;
    if (inspRahu) inspRahu.textContent = dayObj.rahuKaal;
    if (inspSnan) inspSnan.textContent = dayObj.snanSignificance || 'मां नर्मदा दर्शन व नमन';
  }

  function getMonthNameHindi(m) {
    const names = ['', 'जनवरी', 'फरवरी', 'मार्च', 'अप्रैल', 'मई', 'जून', 'जुलाई', 'अगस्त', 'सितंबर', 'अक्टूबर', 'नवंबर', 'दिसंबर'];
    return names[m] || '';
  }

  // Month Select change event
  if (monthSelect) {
    monthSelect.addEventListener('change', (e) => {
      currentMonthIdx = parseInt(e.target.value);
      renderCalendar(currentMonthIdx);
    });
  }

  // Festival search filter
  const searchInput = document.getElementById('festival-search');
  const tableRows = document.querySelectorAll('.festival-row');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      tableRows.forEach(row => {
        const text = row.textContent?.toLowerCase() || '';
        if (text.includes(term)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  }

  // Initial render for November 2026
  renderCalendar(currentMonthIdx);
</script>
