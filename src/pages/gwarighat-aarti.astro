---
import Layout from '../layouts/Layout.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';

const aartiFaqs = [
  {
    q: "ग्वारीघाट में मां नर्मदा महा आरती का समय क्या है?",
    a: "ग्वारीघाट में प्रतिदिन संध्या महा आरती सूर्यास्त के समय होती है। सर्दियों (अक्टूबर से मार्च) में आरती शाम 6:30 बजे से 7:00 बजे तक होती है, जबकि गर्मियों में यह शाम 7:30 बजे से 8:00 बजे तक होती है।"
  },
  {
    q: "ग्वारीघाट दीपदान कैसे किया जाता है?",
    a: "आरती के उपरांत भक्तजन पत्तों के दोनों में पुष्प और दीपक रखकर मां नर्मदा के पावन जल में प्रवाहित करते हैं। संध्या काल में तैरते सैकड़ों दीपकों का दृश्य अत्यंत मनोरम और दिव्य होता है।"
  },
  {
    q: "ग्वारीघाट गुरुद्वारा कैसे पहुंचें?",
    a: "ग्वारीघाट के ठीक सामने नर्मदा के दूसरे तट पर ऐतिहासिक गुरुद्वारा स्थित है, जहां प्रथम सिख गुरु श्री गुरु नानक देव जी पधारे थे। मुख्य घाट से नाव द्वारा मात्र ₹20-30 में 5 मिनट में नदी पार करके गुरुद्वारा पहुंचा जा सकता है।"
  },
  {
    q: "जबलपुर रेलवे स्टेशन से ग्वारीघाट की दूरी कितनी है?",
    a: "जबलपुर मुख्य रेलवे स्टेशन से ग्वारीघाट की दूरी लगभग 8 किलोमीटर है। स्टेशन या मदन महल से ऑटो, ई-रिक्शा या नगर निगम बस द्वारा 20-25 मिनट में आसानी से पहुंचा जा सकता है।"
  }
];

const aartiFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": aartiFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Gwarighat Narmada Maha Aarti Timings 2026 | ग्वारीघाट मां नर्मदा महा आरती समय व दर्शन"
  description="ग्वारीघाट जबलपुर में प्रतिदिन होने वाली मां नर्मदा महा आरती का समय, दीपदान विधि, नाव सेवा, गुरुद्वारा दर्शन और जबलपुर के पवित्र नर्मदा घाटों की संपूर्ण जानकारी।"
  keywords={["Gwarighat Aarti Timing", "Narmada Aarti Jabalpur", "ग्वारीघाट महा आरती", "नर्मदा आरती समय", "Gwarighat Gurudwara", "Tilwara Ghat Jabalpur"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(aartiFaqSchema)} />

  <div class="max-w-4xl mx-auto py-6 sm:py-10 space-y-10">
    
    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20">
        🪔 संस्कारधानी आध्यात्मिक दर्शन
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        ग्वारीघाट मां नर्मदा महा आरती समय व दर्शन गाइड
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        जीवनदायिनी पुण्यसलिला मां नर्मदा के पावन तट ग्वारीघाट पर प्रतिदिन होने वाली दिव्य संध्या महा आरती, दीपदान, नाव यात्रा और आध्यात्मिक महत्व की संपूर्ण जानकारी।
      </p>

      <div class="pt-2 flex justify-center">
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent('🪔 ग्वारीघाट मां नर्मदा महा आरती समय व दर्शन संपूर्ण गाइड 2026:\nhttps://jabalpuriya.com/gwarighat-aarti')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-lg hover:scale-105 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          <span>WhatsApp पर शेयर करें</span>
        </a>
      </div>
    </header>

    <!-- Top Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Aarti Timings Highlight Box -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-orange-600 via-amber-600 to-orange-700 text-white shadow-2xl space-y-4">
      <div class="flex items-center gap-2 text-xs font-black tracking-widest uppercase bg-black/30 w-fit px-3 py-1 rounded-full border border-white/20">
        ⚡ प्रतिदिन आरती समय सारिणी
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15">
          <span class="block text-xs uppercase font-bold text-amber-200">सर्दियों का समय (Winter)</span>
          <span class="text-2xl font-black mt-1 block">शाम 6:30 PM - 7:00 PM</span>
          <p class="text-[11px] text-white/80 mt-1">अक्टूबर से मार्च के दौरान</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15">
          <span class="block text-xs uppercase font-bold text-amber-200">गर्मियों का समय (Summer)</span>
          <span class="text-2xl font-black mt-1 block">शाम 7:30 PM - 8:00 PM</span>
          <p class="text-[11px] text-white/80 mt-1">अप्रैल से सितंबर के दौरान</p>
        </div>
      </div>
      <p class="text-xs text-amber-100">
        * विशेष पर्वों जैसे <strong>नर्मदा जयंती, मकर संक्रांति, कार्तिक पूर्णिमा</strong> पर महा आरती और 108 दीपों की विशेष पूजा का आयोजन होता है।
      </p>
    </div>

    <!-- Spiritual Details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-md space-y-2.5">
        <span class="text-2xl">🪔</span>
        <h3 class="text-base font-black text-slate-900 dark:text-white">नर्मदाष्टक व महा आरती</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          आदि शंकराचार्य रचित 'नर्मदाष्टकम्' (त्वदीय पाद पंकजम नमामि देवि नर्मदे) के सस्वर गायन और विशाल पीतल की महादीप आरती से पूरा वातावरण गुंजायमान हो उठता है।
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-md space-y-2.5">
        <span class="text-2xl">⛵</span>
        <h3 class="text-base font-black text-slate-900 dark:text-white">नाव यात्रा व गुरुद्वारा</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          घाट से नौका द्वारा नदी पार कर गुरुद्वारा ग्वारीघाट और उमा घाट के दर्शन करें। यहां से सूर्यास्त के समय नर्मदा का दृश्य बेहद मनमोहक दिखाई देता है।
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-md space-y-2.5">
        <span class="text-2xl">🌿</span>
        <h3 class="text-base font-black text-slate-900 dark:text-white">नर्मदा स्वच्छता व मर्यादा</h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          नर्मदा नदी में साबुन, शैम्पू या प्लास्टिक का उपयोग पूर्णतः वर्जित है। केवल मिट्टी या आटे के पर्यावरण-अनुकूल दीयों का ही दीपदान करें।
        </p>
      </div>

    </div>

    <!-- Other Jabalpur Ghats -->
    <section class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-[#091526] border border-slate-200 dark:border-slate-800 space-y-4">
      <h3 class="text-lg font-black text-slate-900 dark:text-white">
        संस्कारधानी के अन्य प्रमुख नर्मदा घाट
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm">
        <div class="p-3 bg-white dark:bg-[#0c1c33] rounded-xl border border-slate-200 dark:border-slate-700">
          <strong class="text-jabalpur-secondary block">तिलवारा घाट (Tilwara Ghat)</strong>
          महात्मा गांधी की अस्थि विसर्जन स्थली और गांधी स्मारक।
        </div>
        <div class="p-3 bg-white dark:bg-[#0c1c33] rounded-xl border border-slate-200 dark:border-slate-700">
          <strong class="text-jabalpur-secondary block">सरस्वती घाट (Saraswati Ghat)</strong>
          भेड़ाघाट के समीप शांतिपूर्ण व मनोरम प्राकृतिक घाट।
        </div>
        <div class="p-3 bg-white dark:bg-[#0c1c33] rounded-xl border border-slate-200 dark:border-slate-700">
          <strong class="text-jabalpur-secondary block">लम्हेटा घाट (Lamheta Ghat)</strong>
          विश्वप्रसिद्ध भूवैज्ञानिक जीवाश्म (डायनासोर अवशेष) क्षेत्र।
        </div>
      </div>
    </section>

    <!-- In-Article AdSense -->
    <AdSenseBanner slotType="in-feed" />

    <!-- FAQ Section -->
    <section class="space-y-4">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>❓</span> अक्सर पूछे जाने वाले प्रश्न (FAQs)
      </h2>
      <div class="space-y-3">
        {aartiFaqs.map((faq) => (
          <details class="p-5 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-sm group">
            <summary class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center">
              <span>{faq.q}</span>
              <span class="text-jabalpur-secondary text-lg group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <div class="text-center pt-4">
      <a href="/" class="inline-flex items-center px-6 py-3 rounded-xl font-bold text-sm bg-jabalpur-primary text-white hover:bg-jabalpur-secondary transition-all shadow-md">
        ← मुख्य पृष्ठ (Home) पर लौटें
      </a>
    </div>

  </div>
</Layout>
