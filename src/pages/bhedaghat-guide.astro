---
import Layout from '../layouts/Layout.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';

const faqs = [
  {
    q: "भेड़ाघाट में बोटिंग का समय और शुल्क क्या है?",
    a: "भेड़ाघाट में संगमरमर की चट्टानों के बीच बोटिंग सुबह 7:00 बजे से शाम 7:00 बजे तक खुली रहती है। सामान्य शेयरिंग नाव का किराया ₹100 से ₹150 प्रति व्यक्ति और प्राइवेट नाव का शुल्क ₹600 से ₹1200 तक रहता है। शरद पूर्णिमा और पूर्णिमा की रात चांदनी बोटिंग विशेष आकर्षण होती है।"
  },
  {
    q: "धुआंधार रोपवे (केबल कार) का समय और टिकट कितना है?",
    a: "धुआंधार जलप्रपात का रोपवे सुबह 10:00 बजे से शाम 5:30 बजे तक संचालित होता है। दोनों तरफ (Round Trip) का टिकट लगभग ₹120 से ₹150 प्रति व्यक्ति है।"
  },
  {
    q: "जबलपुर रेलवे स्टेशन से भेड़ाघाट की दूरी और साधन क्या हैं?",
    a: "जबलपुर मुख्य रेलवे स्टेशन से भेड़ाघाट लगभग 21 किलोमीटर दूर है। तीन पत्ती चौक, मदन महल या रेलवे स्टेशन से ऑटो रिक्शा, कैब या मेट्रो बस द्वारा 40-50 मिनट में आसानी से पहुंचा जा सकता है।"
  },
  {
    q: "भेड़ाघाट घूमने का सबसे अच्छा मौसम कौन सा है?",
    a: "भेड़ाघाट और धुआंधार घूमने के लिए सबसे उत्तम समय अक्टूबर से मार्च (शरद व शीत ऋतु) है। मानसून के दौरान (जुलाई से सितंबर) सुरक्षा कारणों से बोटिंग बंद रहती है।"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Bhedaghat & Dhuandhar Falls Guide 2026 | भेड़ाघाट और धुआंधार जलप्रपात संपूर्ण गाइड"
  description="भेड़ाघाट संगमरमर की चट्टानें, धुआंधार जलप्रपात, बोटिंग का समय, रोपवे टिकट, चौंसठ योगिनी मंदिर और जबलपुर से पहुंचने का संपूर्ण यात्रा मार्गदर्शक।"
  keywords={["Bhedaghat Jabalpur", "Dhuandhar Falls", "Marble Rocks Boating Timing", "भेड़ाघाट जबलपुर", "धुआंधार जलप्रपात", "चौंसठ योगिनी मंदिर", "Bhedaghat Cable Car Ticket"]}
>
  <!-- Schema.org FAQ Rich Snippet -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto py-6 sm:py-10 space-y-10">
    
    <!-- Hero Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        🏛️ संस्कारधानी जबलपुर पर्यटन गाइड
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        भेड़ाघाट व धुआंधार जलप्रपात संपूर्ण गाइड
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        सफेद संगमरमर की भव्य घाटियां, मां नर्मदा का विहंगम धुआंधार फॉल, नौकायन का समय, रोपवे किराया और चौंसठ योगिनी मंदिर दर्शन की प्रामाणिक जानकारी।
      </p>

      <!-- WhatsApp Share Bar -->
      <div class="pt-2 flex justify-center">
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent('🌊 भेड़ाघाट व धुआंधार जलप्रपात जबलपुर संपूर्ण गाइड 2026 - बोटिंग समय, रोपवे टिकट और पूरी जानकारी पढ़ें:\nhttps://jabalpuriya.com/bhedaghat-guide')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-lg hover:scale-105 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-1.109-.064-.407-.129-.933-.312-1.611-.607-1.425-.62-2.353-2.073-2.424-2.167-.071-.095-.579-.77-.579-1.469 0-.698.367-1.042.498-1.185.132-.143.287-.179.383-.179s.191.006.275.011c.088.005.206-.033.322.247.119.287.407 1.002.443 1.074.036.072.06.155.012.251-.048.096-.072.155-.144.239-.072.084-.151.187-.216.251-.072.072-.147.151-.063.295.084.144.373.615.8 1.001.551.498 1.015.653 1.159.724.144.072.228.06.312-.036.084-.096.359-.419.455-.563.096-.144.191-.12.323-.072.132.048.837.395.981.467.144.072.24.108.275.167.036.06.036.347-.108.752zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          <span>दोस्तों के साथ WhatsApp पर शेयर करें</span>
        </a>
      </div>
    </header>

    <!-- Top Ad Placement -->
    <AdSenseBanner slotType="masthead" />

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Dhuandhar Waterfall -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-lg space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-sky-500 text-white flex items-center justify-center text-xl shadow">
          🌊
        </div>
        <h2 class="text-xl font-black text-slate-900 dark:text-white">1. धुआंधार जलप्रपात (Dhuandhar Falls)</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          नर्मदा नदी जब 98 फीट की ऊंचाई से सफेद संगमरमर की चट्टानों पर गिरती है, तो पानी की सूक्ष्म बूंदें धुएं की भांति गगनचुंबी बादल बनाती हैं, जिसे 'धुआंधार' कहा जाता है। नदी के दोनों किनारों पर देखने के लिए सुरक्षित व्यूइंग गैलरी और पाथवे बनाए गए हैं।
        </p>
        <div class="text-xs font-semibold text-slate-500 pt-1">
          ✓ समय: सूर्योदय से सूर्यास्त • प्रवेश: निःशुल्क
        </div>
      </div>

      <!-- Boating in Marble Rocks -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-lg space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center text-xl shadow">
          🚣
        </div>
        <h2 class="text-xl font-black text-slate-900 dark:text-white">2. संगमरमर की चट्टानों में बोटिंग (Marble Rocks Boating)</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          पंचवटी घाट से 3 किलोमीटर तक 100 फीट ऊंची सफेद, गुलाबी और नीली संगमरमर की चट्टानों के बीच नाव चलाना एक जादुई अनुभव है। स्थानीय नाविकों की हास्य कविताएं और 'बंदर कूदनी' स्थल बोटिंग को यादगार बनाते हैं।
        </p>
        <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 pt-1">
          ✓ शुल्क: ₹100-₹150 (शेयरिंग), ₹800-₹1200 (प्राइवेट बोट)
        </div>
      </div>

      <!-- Ropeway / Cable Car -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-lg space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shadow">
          🚡
        </div>
        <h2 class="text-xl font-black text-slate-900 dark:text-white">3. धुआंधार केबल कार (Ropeway)</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          धुआंधार फॉल के ऊपर से नर्मदा नदी को पार करने वाला रोपवे विहंगम 360-डिग्री दृश्य प्रदान करता है। यह पूर्वी और पश्चिमी तट को जोड़ता है और फोटोग्राफी के लिए सबसे लोकप्रिय स्थल है।
        </p>
        <div class="text-xs font-semibold text-amber-600 dark:text-amber-400 pt-1">
          ✓ समय: 10:00 AM - 5:30 PM • टिकट: ₹120-₹150 प्रति व्यक्ति
        </div>
      </div>

      <!-- Chausath Yogini Temple -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-lg space-y-3">
        <div class="w-10 h-10 rounded-2xl bg-purple-500 text-white flex items-center justify-center text-xl shadow">
          🛕
        </div>
        <h2 class="text-xl font-black text-slate-900 dark:text-white">4. चौंसठ योगिनी मंदिर (Chausath Yogini)</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          10वीं शताब्दी में कलचुरी राजवंश द्वारा निर्मित यह ऐतिहासिक मंदिर पहाड़ी पर स्थित है। 108 सीढ़ियां चढ़कर पहुंचने पर 64 योगिनियों की अद्वितीय पत्थर की प्रतिमाएं और गर्भगृह में भगवान शिव-पार्वती की नंदी पर सवार दुर्लभ मूर्ति स्थापित है।
        </p>
        <div class="text-xs font-semibold text-purple-600 dark:text-purple-400 pt-1">
          ✓ समय: सुबह 7:00 बजे से शाम 6:00 बजे तक
        </div>
      </div>

    </div>

    <!-- In-Content Ad -->
    <AdSenseBanner slotType="in-feed" />

    <!-- Travel Tips & Shopping -->
    <section class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-[#091526] border border-slate-200 dark:border-slate-800 space-y-4">
      <h3 class="text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>🛍️</span> भेड़ाघाट की प्रसिद्ध खरीदारी (Shopping & Souvenirs)
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        भेड़ाघाट का स्थानीय सोपस्टोन (सफेद शैल पत्थर) शिल्प भारत भर में विख्यात है। यहां के स्थानीय कारीगर संगमरमर और सोपस्टोन पर आपका नाम, देवी-देवताओं की सुंदर मूर्तियां, शिवलिंग और सजावटी वस्तुएं मात्र 10 मिनट में नक्काशी करके देते हैं।
      </p>
    </section>

    <!-- FAQs Section (Rich Snippets) -->
    <section class="space-y-4">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2">
        <span>❓</span> अक्सर पूछे जाने वाले सवाल (FAQs)
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="p-5 rounded-2xl bg-white dark:bg-[#0c1c33] border border-slate-200 dark:border-slate-800 shadow-sm group">
            <summary class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer list-none flex justify-between items-center">
              <span>{faq.q}</span>
              <span class="text-jabalpur-secondary text-lg group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Navigation CTA -->
    <div class="text-center pt-4">
      <a href="/" class="inline-flex items-center px-6 py-3 rounded-xl font-bold text-sm bg-jabalpur-primary text-white hover:bg-jabalpur-secondary transition-all shadow-md">
        ← मुख्य पृष्ठ (Home) पर लौटें
      </a>
    </div>

  </div>
</Layout>
